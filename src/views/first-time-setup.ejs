<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ตั้งค่าข้อมูลส่วนตัว - Slow Aging</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sarabun: ['Sarabun', 'sans-serif'] },
          colors: {
            green: {
              primary: '#2d7a3a',
              light: '#3a9e4a',
              pale: '#e8f5e9',
              hover: '#f0faf1',
              muted: '#8fbc8f',
              ring: 'rgba(45,122,58,0.15)',
            }
          }
        }
      }
    }
  </script>
  <style>
    * {
      font-family: 'Sarabun', sans-serif;
    }

    /* Scrollbar ใน modal body */
    #termsModalBody::-webkit-scrollbar {
      width: 4px;
    }

    #termsModalBody::-webkit-scrollbar-thumb {
      background: #c5d6c5;
      border-radius: 4px;
    }
  </style>
</head>

<body class="min-h-screen bg-white flex flex-col items-center font-sarabun">

  <div class="w-full max-w-md sm:max-w-lg md:max-w-xl lg:max-w-2xl mx-auto flex flex-col min-h-screen">

    <!-- ===== Header ===== -->
    <div
      class="w-full flex flex-col items-center px-6 pt-14 pb-10 sm:pt-16 sm:pb-12 text-white shadow-md bg-gradient-to-br from-[#2d7a3a] to-[#3a9e4a]">
      <div id="profileImageContainer"
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-white/25 flex items-center justify-center mb-4">
        <span class="iconify text-white text-[52px]" data-icon="solar:user-circle-outline"></span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-center">ตั้งค่าข้อมูลส่วนตัว</h1>
      <p class="text-base sm:text-lg font-medium text-center mt-2 text-white/85">กรอกข้อมูลของท่านเพื่อเริ่มต้นใช้งาน
      </p>
    </div>

    <!-- ===== Form ===== -->
    <div class="flex-1 flex flex-col gap-6 px-5 sm:px-8 md:px-10 py-8">

      <!-- ชื่อ-นามสกุล -->
      <div>
        <label class="flex items-center gap-2 text-xl sm:text-2xl font-extrabold mb-3 text-[#1a2e1a]">
          ชื่อ-นามสกุล
        </label>
        <input type="text" id="profileName" placeholder="กรอกชื่อและนามสกุล"
          class="w-full px-4 py-4 sm:py-5 border border-gray-300 rounded-xl text-lg sm:text-xl text-gray-700 bg-white outline-none transition-all duration-200 focus:border-[#2d7a3a] focus:ring-2 focus:ring-[#2d7a3a]/20" />
      </div>

      <!-- ชุมชน/หมู่บ้าน — Custom Dropdown -->
      <div>
        <label class="flex items-center gap-2 text-xl sm:text-2xl font-extrabold mb-3 text-[#1a2e1a]">
          ชุมชน/หมู่บ้าน
        </label>

        <div class="relative select-none" id="villageDropdown">

          <!-- Trigger -->
          <button type="button" id="villageTrigger" onclick="toggleDropdown()"
            class="w-full px-4 py-4 sm:py-5 pr-12 border border-gray-300 rounded-xl text-lg sm:text-xl text-gray-400 bg-white flex items-center text-left transition-all duration-200 cursor-pointer">
            <span id="villageLabel" class="flex-1">เช่น ชุมชนบ้านสุขใจ</span>
            <span id="dropdownArrow"
              class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 transition-transform duration-200 flex items-center">
              <span class="iconify text-2xl" data-icon="solar:alt-arrow-down-outline"></span>
            </span>
          </button>

          <!-- Dropdown List -->
          <div id="villageList"
            class="hidden absolute top-full left-0 right-0 bg-white border border-[#2d7a3a] border-t-0 rounded-b-xl overflow-hidden z-50 shadow-lg">

            <div class="divide-y divide-gray-100">
              <button type="button" onclick="selectVillage('ชุมชนบ้านสุขใจ', this)"
                class="w-full px-4 py-4 text-lg sm:text-xl text-gray-700 flex items-center gap-2.5 hover:bg-[#f0faf1] transition-colors duration-150 text-left">
                <span>ชุมชนบ้านสุขใจ</span>
                <span class="check-mark iconify text-[#2d7a3a] ml-auto text-lg hidden"
                  data-icon="solar:check-circle-outline"></span>
              </button>
              <button type="button" onclick="selectVillage('ชุมชนรักษ์ป่า', this)"
                class="w-full px-4 py-4 text-lg sm:text-xl text-gray-700 flex items-center gap-2.5 hover:bg-[#f0faf1] transition-colors duration-150 text-left">

                <span>ชุมชนรักษ์ป่า</span>
                <span class="check-mark iconify text-[#2d7a3a] ml-auto text-lg hidden"
                  data-icon="solar:check-circle-outline"></span>
              </button>
              <button type="button" onclick="selectVillage('ชุมชนพัฒนา', this)"
                class="w-full px-4 py-4 text-lg sm:text-xl text-gray-700 flex items-center gap-2.5 hover:bg-[#f0faf1] transition-colors duration-150 text-left">

                <span>ชุมชนพัฒนา</span>
                <span class="check-mark iconify text-[#2d7a3a] ml-auto text-lg hidden"
                  data-icon="solar:check-circle-outline"></span>
              </button>
              <button type="button" onclick="selectVillage('ชุมชนมิตรภาพ', this)"
                class="w-full px-4 py-4 text-lg sm:text-xl text-gray-700 flex items-center gap-2.5 hover:bg-[#f0faf1] transition-colors duration-150 text-left">

                <span>ชุมชนมิตรภาพ</span>
                <span class="check-mark iconify text-[#2d7a3a] ml-auto text-lg hidden"
                  data-icon="solar:check-circle-outline"></span>
              </button>
            </div>
          </div>
        </div>
        <input type="hidden" id="profileVillage" value="" />
      </div>

      <!-- Checkbox เงื่อนไข -->
      <div class="flex items-center gap-3">
        <input type="checkbox" id="termsCheckbox"
          class="w-6 h-6 rounded shrink-0 cursor-pointer accent-[#2d7a3a]" />
        <label for="termsCheckbox" class="text-lg sm:text-xl text-stone-600 cursor-pointer leading-relaxed">
          ยอมรับ
          <button type="button" id="openTermsBtn"
            class="text-[#2d7a3a] font-bold underline bg-transparent border-none p-0 text-lg sm:text-xl cursor-pointer font-sarabun">
            เงื่อนไขและข้อตกลง
          </button>
        </label>
      </div>

      <div class="flex-1"></div>

      <!-- Submit -->
      <button id="submitBtn" disabled
        class="w-full py-5 sm:py-6 rounded-2xl font-extrabold text-white text-xl sm:text-2xl flex items-center justify-center gap-2 transition-colors duration-200 bg-[#8fbc8f] cursor-not-allowed">
        เริ่มต้นใช้งาน
      </button>
    </div>
  </div>


  <!-- ===== Terms Modal ===== -->
  <div id="termsModal" class="hidden fixed inset-0 z-[999] bg-black/40 items-end">
    <div class="w-full max-w-[600px] mx-auto bg-white rounded-t-3xl max-h-[90vh] flex flex-col overflow-hidden">

      <!-- Modal Header -->
      <div
        class="flex flex-col items-center gap-2 px-6 pt-8 pb-6 shrink-0 bg-gradient-to-br from-[#2d7a3a] to-[#3a9e4a]">
        <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center mb-1">
          <span class="iconify text-white text-[36px]" data-icon="solar:shield-check-outline"></span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white text-center m-0">เงื่อนไขและข้อตกลง</h2>
        <p class="text-base sm:text-lg text-white/85 text-center m-0">กรุณาอ่านและยอมรับก่อนเริ่มใช้งาน</p>
      </div>

      <!-- Modal Body -->
      <div id="termsModalBody" class="overflow-y-auto p-6 flex-1">
        <div class="flex flex-col gap-5">

          <div>
            <h3 class="text-lg sm:text-xl font-bold mb-2 text-[#2d7a3a]">
              1. การเก็บรวบรวมข้อมูล
            </h3>
            <p class="text-base sm:text-lg leading-relaxed text-gray-700 m-0">
              ระบบนี้จัดทำโดยเทศบาล/โรงพยาบาลส่งเสริมสุขภาพตำบล เพื่อส่งเสริมสุขภาพผู้สูงอายุ
              ท่านยินยอมให้เราเก็บข้อมูลส่วนตัว ได้แก่ ชื่อ-นามสกุล ชุมชน/หมู่บ้าน และข้อมูล LINE Account ของท่าน
            </p>
          </div>

          <div>
            <h3 class="text-lg sm:text-xl font-bold mb-2 text-[#2d7a3a]">
              2. การใช้ข้อมูล
            </h3>
            <p class="text-base sm:text-lg leading-relaxed text-gray-700 m-0">
              ข้อมูลของท่านจะถูกใช้เพื่อติดตามความก้าวหน้าการออกกำลังกาย ส่งการแจ้งเตือนผ่าน LINE
              และรายงานผลต่อเจ้าหน้าที่สาธารณสุขเพื่อดูแลสุขภาพของท่านเท่านั้น
            </p>
          </div>

          <div>
            <h3 class="text-lg sm:text-xl font-bold mb-2 text-[#2d7a3a]">
              3. การเปิดเผยข้อมูล
            </h3>
            <p class="text-base sm:text-lg leading-relaxed text-gray-700 m-0">
              ข้อมูลของท่านจะไม่ถูกเปิดเผยแก่บุคคลภายนอก ยกเว้นเจ้าหน้าที่สาธารณสุขที่ได้รับอนุญาต
              และหน่วยงานราชการตามที่กฎหมายกำหนด
            </p>
          </div>

          <div>
            <h3 class="text-lg sm:text-xl font-bold mb-2 text-[#2d7a3a]">
              4. สิทธิ์ของท่าน
            </h3>
            <p class="text-base sm:text-lg leading-relaxed text-gray-700 m-0">
              ท่านมีสิทธิ์ขอดู แก้ไข หรือลบข้อมูลส่วนตัวของท่านได้ทุกเมื่อ โดยติดต่อเจ้าหน้าที่ผ่านเมนู
              "ติดต่อเจ้าหน้าที่" ในแอปพลิเคชัน
            </p>
          </div>

          <div class="mb-2">
            <h3 class="text-lg sm:text-xl font-bold mb-2 text-[#2d7a3a]">

              5. ความปลอดภัย
            </h3>
            <p class="text-base sm:text-lg leading-relaxed text-gray-700 m-0">
              เราใช้มาตรการรักษาความปลอดภัยตามมาตรฐาน พ.ร.บ. คุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562 (PDPA)
              เพื่อปกป้องข้อมูลของท่าน
            </p>
          </div>

        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 pb-8 pt-4 shrink-0 border-t border-stone-100">
        <button id="acceptTermsBtn"
          class="w-full py-5 rounded-2xl font-extrabold text-white text-xl sm:text-2xl flex items-center justify-center gap-2 cursor-pointer bg-[#2d7a3a] border-none font-sarabun">
          <span class="iconify text-2xl" data-icon="solar:check-circle-outline"></span>
          ยอมรับ
        </button>
      </div>
    </div>
  </div>


  <script>
    const nameInput = document.getElementById('profileName');
    const villageInput = document.getElementById('profileVillage');
    const termsCheckbox = document.getElementById('termsCheckbox');
    const submitBtn = document.getElementById('submitBtn');
    const profileImgCont = document.getElementById('profileImageContainer');
    const termsModal = document.getElementById('termsModal');
    const openTermsBtn = document.getElementById('openTermsBtn');
    const acceptTermsBtn = document.getElementById('acceptTermsBtn');
    const villageTrigger = document.getElementById('villageTrigger');
    const villageList = document.getElementById('villageList');
    const villageLabel = document.getElementById('villageLabel');
    const dropdownArrow = document.getElementById('dropdownArrow');

    // ===== Dropdown =====
    function toggleDropdown() {
      villageList.classList.contains('hidden') ? openDropdown() : closeDropdown();
    }

    function openDropdown() {
      villageList.classList.remove('hidden');
      villageList.classList.add('flex', 'flex-col');
      villageTrigger.classList.add('border-[#2d7a3a]', 'ring-2', 'ring-[#2d7a3a]/20', 'rounded-b-none');
      dropdownArrow.classList.add('rotate-180');
    }

    function closeDropdown() {
      villageList.classList.add('hidden');
      villageList.classList.remove('flex', 'flex-col');
      villageTrigger.classList.remove('border-[#2d7a3a]', 'ring-2', 'ring-[#2d7a3a]/20', 'rounded-b-none');
      dropdownArrow.classList.remove('rotate-180');
    }

    function selectVillage(value, el) {
      villageLabel.textContent = value;
      villageLabel.classList.remove('text-gray-400');
      villageLabel.classList.add('text-gray-700');
      villageInput.value = value;

      // reset all options
      document.querySelectorAll('#villageList button').forEach(btn => {
        btn.classList.remove('bg-[#e8f5e9]', 'text-[#2d7a3a]', 'font-bold');
        btn.querySelector('.check-mark')?.classList.add('hidden');
      });

      // mark selected
      el.classList.add('bg-[#e8f5e9]', 'text-[#2d7a3a]', 'font-bold');
      el.querySelector('.check-mark')?.classList.remove('hidden');

      closeDropdown();
      checkValidity();
    }

    // ปิด dropdown เมื่อคลิกนอก
    document.addEventListener('click', (e) => {
      if (!document.getElementById('villageDropdown').contains(e.target)) closeDropdown();
    });

    // ===== LIFF =====
    let lineProfile = null;
    const LIFF_ID = "<%= LIFF_ID %>";

    async function initializeLiff() {
      try {
        await liff.init({ liffId: LIFF_ID });
        if (liff.isLoggedIn()) {
          lineProfile = await liff.getProfile();
          if (lineProfile.displayName && !nameInput.value) nameInput.value = lineProfile.displayName;
          if (lineProfile.pictureUrl) {
            profileImgCont.innerHTML = `<img src="${lineProfile.pictureUrl}" alt="Profile" class="w-full h-full rounded-full object-cover"/>`;
          }
          checkValidity();
        }
      } catch (err) {
        console.error("LIFF Init Error:", err);
      }
    }
    initializeLiff();

    // ===== Validity =====
    function checkValidity() {
      const valid =
        nameInput.value.trim().length > 0 &&
        villageInput.value.trim().length > 0 &&
        termsCheckbox.checked;

      submitBtn.disabled = !valid;
      if (valid) {
        submitBtn.classList.replace('bg-[#8fbc8f]', 'bg-[#2d7a3a]');
        submitBtn.classList.replace('cursor-not-allowed', 'cursor-pointer');
        submitBtn.classList.add('hover:opacity-95', 'active:scale-[0.98]');
      } else {
        submitBtn.classList.replace('bg-[#2d7a3a]', 'bg-[#8fbc8f]');
        submitBtn.classList.replace('cursor-pointer', 'cursor-not-allowed');
        submitBtn.classList.remove('hover:opacity-95', 'active:scale-[0.98]');
      }
    }

    nameInput.addEventListener('input', checkValidity);
    termsCheckbox.addEventListener('change', checkValidity);

    // ===== Modal =====
    openTermsBtn.addEventListener('click', (e) => {
      e.preventDefault();
      termsModal.classList.remove('hidden');
      termsModal.classList.add('flex');
    });

    acceptTermsBtn.addEventListener('click', () => {
      termsCheckbox.checked = true;
      termsModal.classList.add('hidden');
      termsModal.classList.remove('flex');
      checkValidity();
    });

    termsModal.addEventListener('click', (e) => {
      if (e.target === termsModal) {
        termsModal.classList.add('hidden');
        termsModal.classList.remove('flex');
      }
    });

    // ===== Submit =====
    submitBtn.addEventListener('click', async () => {
      submitBtn.innerHTML = `<span class="iconify text-xl" data-icon="solar:loading-outline"></span> กำลังบันทึก...`;
      submitBtn.disabled = true;

      const userData = {
        userId: lineProfile ? lineProfile.userId : "U_DEV",
        profileName: nameInput.value.trim(),
        profileVillage: villageInput.value.trim(),
        pictureUrl: lineProfile?.pictureUrl || "",
        isAcceptedTerms: termsCheckbox.checked,
      };

      try {
        const res = await fetch("/api/user/setup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(userData),
        });
        const result = res.ok ? await res.json() : {};
        localStorage.setItem("user_profile_data", JSON.stringify(result.data || userData));
      } catch {
        localStorage.setItem("user_profile_data", JSON.stringify(userData));
      }

      window.location.replace("/home");
    });
  </script>
</body>

</html>