<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>กิจกรรมที่ยังไม่เสร็จ - Slow Aging</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Iconify -->
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap');
    body {
      font-family: 'Prompt', sans-serif;
    }
    .hidden { display: none !important; }
  </style>
</head>
<body class="bg-[#f5f7f5]">

  <!-- =========================================================
       VIEW 1: หน้ารายการกิจกรรมที่ยังไม่เสร็จ
       ========================================================= -->
  <div id="listView" class="flex flex-col min-h-screen w-full justify-between">
    <div class="w-full max-w-md md:max-w-2xl lg:max-w-3xl mx-auto flex-1 flex flex-col justify-between px-5 sm:px-8 pt-6 sm:pt-10 pb-10">
      <div>
        <!-- Header -->
        <div class="relative flex items-center justify-center mb-6 sm:mb-8">
          <a href="/tasks" class="absolute left-0 p-2 -ml-2 text-black cursor-pointer hover:bg-stone-200/60 rounded-2xl transition-colors">
            <span class="iconify text-3xl sm:text-4xl" data-icon="mdi:arrow-left"></span>
          </a>
          <div class="text-center">
            <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1a2e1a]">กิจกรรมที่ยังไม่เสร็จ</h1>
            <p class="text-lg sm:text-xl font-bold text-red-600 mt-1.5">ภารกิจของวันก่อนหน้าที่ยังทำไม่ครบ</p>
          </div>
        </div>

        <!-- Task Cards List -->
        <div id="taskListContainer" class="space-y-4 sm:space-y-5">
          <!-- Inject by JS -->
        </div>

        <!-- State When All Done -->
        <div id="allDoneState" class="hidden text-center py-16 sm:py-24 space-y-3 bg-white rounded-3xl border border-stone-200 shadow-sm p-6">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-emerald-100 text-[#2d7a3a] flex items-center justify-center mx-auto mb-2 shadow-inner">
            <span class="iconify text-5xl sm:text-6xl" data-icon="mdi:check-circle"></span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a]">ไม่มีกิจกรรมค้างแล้ว</h3>
          <p class="text-lg sm:text-xl text-stone-600 font-semibold">ท่านทำภารกิจย้อนหลังครบถ้วนแล้ว เก่งมากๆ ครับ!</p>
        </div>
      </div>

      <!-- ปุ่มกลับสู่ภารกิจวันนี้ -->
      <div class="pt-8">
        <a href="/tasks" class="block w-full text-center py-5 sm:py-6 rounded-2xl font-extrabold text-white text-2xl sm:text-3xl cursor-pointer active:scale-[0.98] transition-transform shadow-lg" style="background: #2d7a3a;">
          กลับสู่ภารกิจวันนี้
        </a>
      </div>
    </div>
  </div>

  <!-- =========================================================
       VIEW 2: หน้ารายละเอียดวิธีทำท่า
       ========================================================= -->
  <div id="detailView" class="hidden flex flex-col min-h-screen w-full bg-[#f5f7f5] justify-between">
    <div class="w-full max-w-md md:max-w-2xl lg:max-w-3xl mx-auto flex-1 flex flex-col px-5 sm:px-8 pt-6 sm:pt-10 pb-10">
      <!-- Header -->
      <div class="flex items-center mb-6 sm:mb-8">
        <button onclick="closeDetailView()" class="p-2 -ml-2 text-black cursor-pointer hover:bg-stone-200/60 rounded-2xl transition-colors">
          <span class="iconify text-3xl sm:text-4xl" data-icon="mdi:arrow-left"></span>
        </button>
        <h1 id="detailHeaderTitle" class="text-3xl sm:text-4xl font-extrabold text-center flex-1 pr-8 sm:pr-10 text-[#1a2e1a]">
          วิธีทำท่า
        </h1>
      </div>

      <!-- Guide Video / Image -->
      <div class="relative w-full rounded-3xl overflow-hidden mb-6 sm:mb-8 bg-stone-100 border-2 border-stone-200 shadow-sm">
        <img id="detailImage" src="" alt="Thumbnail" class="w-full h-64 sm:h-80 md:h-96 object-cover" />
        <div class="absolute inset-0 flex items-center justify-center bg-black/25">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-white/95 flex items-center justify-center text-stone-800 shadow-xl">
            <span class="iconify text-5xl sm:text-6xl ml-1 text-[#2d7a3a]" data-icon="mdi:play"></span>
          </div>
        </div>
        <div id="guideImagesContainer" class="absolute top-3 inset-x-3 flex justify-between gap-2 text-sm sm:text-base text-stone-800 font-bold"></div>
      </div>

      <!-- Details -->
      <div class="space-y-2 mb-6 sm:mb-8 bg-white p-6 rounded-3xl border border-stone-200 shadow-sm">
        <h2 id="detailTitle" class="text-3xl sm:text-4xl font-extrabold text-[#1a2e1a]"></h2>
        <p id="detailReps" class="text-2xl sm:text-3xl font-extrabold text-[#2d7a3a]"></p>
        <p id="detailDuration" class="text-lg sm:text-xl font-bold text-stone-600"></p>
      </div>

      <!-- วิธีทำ -->
      <div class="space-y-4 mb-6 sm:mb-8 bg-white p-6 rounded-3xl border border-stone-200 shadow-sm">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a]">วิธีทำ</h3>
        <div id="detailSteps" class="space-y-3 text-xl sm:text-2xl text-stone-800 leading-relaxed font-medium"></div>
      </div>

      <!-- ข้อควรระวัง -->
      <div class="p-5 bg-amber-50 rounded-2xl border-2 border-amber-200 mb-8">
        <p class="text-lg sm:text-xl font-bold text-amber-900 mb-1">⚠️ ข้อควรระวัง</p>
        <p id="detailCaution" class="text-base sm:text-lg text-amber-800 font-semibold leading-relaxed"></p>
      </div>

      <!-- ปุ่มทำเสร็จแล้ว -->
      <div class="mt-auto pt-2">
        <button id="toggleCompleteBtn" class="w-full flex items-center justify-center gap-3 py-5 sm:py-6 rounded-2xl font-extrabold text-white text-2xl sm:text-3xl cursor-pointer active:scale-[0.98] transition-transform shadow-lg" style="background: #2d7a3a;">
          <span class="iconify text-3xl sm:text-4xl" data-icon="mdi:check"></span>
          <span>ทำเสร็จแล้ว</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    let incompleteTasks = [];
    let currentSelectedTask = null;

    function init() {
      const saved = localStorage.getItem("previous_incomplete_tasks");
      if (saved) {
        try {
          incompleteTasks = JSON.parse(saved);
        } catch (e) {
          console.error("Failed to parse tasks", e);
        }
      } else {
        // Mock ตัวอย่าง
        incompleteTasks = [
          {
            id: 101, title: "บริหารคอ (ย้อนหลัง)", reps: "10 ครั้ง", duration: "(ประมาณ 1 นาที)", completed: false,
            image: "https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=400&auto=format&fit=crop&q=80",
            steps: ["1. นั่งหรือยืนหลังตรง", "2. ค่อยๆ หมุนคอไปทางซ้าย", "3. กลับมาที่ท่ากลาง", "4. หมุนคอไปทางขวา", "5. ทำซ้ำจนครบ"],
            caution: "ทำช้าๆ ไม่กระตุก",
          }
        ];
      }
      renderList();
    }

    function renderList() {
      const container = document.getElementById("taskListContainer");
      const allDoneState = document.getElementById("allDoneState");
      container.innerHTML = "";

      const pendingList = incompleteTasks.filter(t => !t.completed);

      if (pendingList.length === 0) {
        container.classList.add("hidden");
        allDoneState.classList.remove("hidden");
        return;
      }

      container.classList.remove("hidden");
      allDoneState.classList.add("hidden");

      pendingList.forEach((task, idx) => {
        const card = document.createElement("div");
        card.className = "flex items-center gap-5 p-5 sm:p-6 rounded-3xl border-2 border-red-200 bg-white cursor-pointer active:scale-[0.99] hover:border-red-400 transition-all shadow-sm";
        card.onclick = () => openDetailView(task.id);

        card.innerHTML = `
          <img src="${task.image}" alt="${task.title}" class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover shrink-0 shadow-xs border border-stone-200" />
          <div class="flex-1 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a] truncate">${task.title}</h3>
            <p class="text-lg sm:text-xl text-red-600 font-bold mt-1">${task.reps} <span class="text-stone-500 font-semibold">${task.duration}</span></p>
            <div class="mt-2 flex items-center gap-1.5">
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-base font-bold bg-red-100 text-red-700">
                <span class="iconify text-xl" data-icon="mdi:alert-circle-outline"></span> ยังค้างอยู่
              </span>
            </div>
          </div>
          <span class="iconify text-3xl text-stone-400 shrink-0" data-icon="mdi:chevron-right"></span>
        `;
        container.appendChild(card);
      });
    }

    function openDetailView(taskId) {
      currentSelectedTask = incompleteTasks.find(t => t.id === taskId);
      if (!currentSelectedTask) return;

      document.getElementById("detailTitle").innerText = currentSelectedTask.title;
      document.getElementById("detailReps").innerText = currentSelectedTask.reps;
      document.getElementById("detailDuration").innerText = currentSelectedTask.duration;
      document.getElementById("detailImage").src = currentSelectedTask.image;
      document.getElementById("detailCaution").innerText = currentSelectedTask.caution || "ระมัดระวังอาการเจ็บหรือเวียนศีรษะ";

      const stepsContainer = document.getElementById("detailSteps");
      stepsContainer.innerHTML = currentSelectedTask.steps.map(s => `<p class="py-1">${s}</p>`).join("");

      document.getElementById("listView").classList.add("hidden");
      document.getElementById("detailView").classList.remove("hidden");
      window.scrollTo(0, 0);
    }

    function closeDetailView() {
      document.getElementById("detailView").classList.add("hidden");
      document.getElementById("listView").classList.remove("hidden");
      window.scrollTo(0, 0);
    }

    document.getElementById("toggleCompleteBtn").addEventListener("click", () => {
      if (!currentSelectedTask) return;
      currentSelectedTask.completed = true;
      localStorage.setItem("previous_incomplete_tasks", JSON.stringify(incompleteTasks));
      renderList();
      closeDetailView();
    });

    init();
  </script>
</body>
</html>
