<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>กิจกรรมที่ยังไม่เสร็จ - Slow Aging</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap');

    body {
      font-family: 'Sarabun', sans-serif;
    }

    .hidden {
      display: none !important;
    }
  </style>
</head>

<body class="bg-white min-h-screen">

  <div class="w-full max-w-md md:max-w-2xl lg:max-w-3xl mx-auto min-h-screen flex flex-col px-5 sm:px-8 pt-6 sm:pt-10 pb-10">

    <!-- Header -->
    <div class="relative flex items-center justify-center mb-2">
      <a href="/tasks"
        class="absolute left-0 p-2 -ml-2 text-black cursor-pointer hover:bg-stone-200/60 rounded-2xl transition-colors">
        <span class="iconify text-3xl sm:text-4xl" data-icon="solar:arrow-left-outline"></span>
      </a>
      <div class="text-center">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1a2e1a]">กิจกรรมที่ยังไม่เสร็จ</h1>
        <p class="text-lg sm:text-xl font-bold text-red-500 mt-1">ภารกิจของวันก่อนหน้าที่ยังทำไม่ครบ</p>
      </div>
    </div>

    <!-- Month Navigator -->
    <div class="flex items-center justify-center gap-6 my-5 sm:my-6">
      <button onclick="changeMonth(-1)"
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-100 hover:bg-stone-200 active:scale-95 transition-all cursor-pointer">
        <span class="iconify text-2xl text-stone-600" data-icon="solar:alt-arrow-left-outline"></span>
      </button>
      <span id="monthLabel" class="text-xl sm:text-2xl font-bold text-[#1a2e1a] min-w-[160px] text-center">
        สิงหาคม 2568
      </span>
      <button onclick="changeMonth(1)"
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-100 hover:bg-stone-200 active:scale-95 transition-all cursor-pointer">
        <span class="iconify text-2xl text-stone-600" data-icon="solar:alt-arrow-right-outline"></span>
      </button>
    </div>

    <!-- Task List -->
    <div id="taskListContainer" class="space-y-4 sm:space-y-5 flex-1">
      <!-- Inject by JS -->
    </div>

    <!-- All Done State -->
    <div id="allDoneState"
      class="hidden text-center py-16 sm:py-24 space-y-3 bg-white rounded-3xl border border-stone-200 shadow-xs p-6">
      <div
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-emerald-100 text-[#2d7a3a] flex items-center justify-center mx-auto mb-2">
        <span class="iconify text-5xl sm:text-6xl" data-icon="solar:check-circle-outline"></span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a]">ไม่มีกิจกรรมค้างแล้ว</h3>
      <p class="text-lg sm:text-xl text-stone-600 font-semibold">ท่านทำภารกิจย้อนหลังครบถ้วนแล้ว เก่งมากๆ ครับ!</p>
    </div>

  </div>

  <script id="serverExercisesData" type="application/json">
    <%- JSON.stringify(typeof exercises !== 'undefined' ? exercises : []) %>
  </script>
  <script>
    const serverExercises = JSON.parse(document.getElementById('serverExercisesData')?.textContent || '[]');
    let incompleteTasks = [];
    let currentMonthOffset = 0;

    const MONTHS_TH = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
      "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];

    function init() {
      updateMonthLabel();

      // ดึงงานที่ยังไม่เสร็จจาก exercise_tasks_data
      const savedTasks = localStorage.getItem("exercise_tasks_data");
      if (savedTasks) {
        try {
          const parsed = JSON.parse(savedTasks);
          incompleteTasks = parsed.filter(t => !t.completed);
        } catch (e) {
          incompleteTasks = [];
        }
      } else if (serverExercises && serverExercises.length > 0) {
        incompleteTasks = serverExercises.map(ex => ({
          id: ex.id,
          title: ex.name,
          reps: `${ex.quantity} ${ex.unit || 'ครั้ง'}`,
          duration: `(ประมาณ ${ex.duration} ${ex.duration_unit || 'นาที'})`,
          completed: false,
          image: (ex.media && ex.media.length > 0 ? ex.media[0].url : "/images/headermain.svg")
        }));
      } else {
        incompleteTasks = [];
      }

      renderList();
    }

    function changeMonth(delta) {
      currentMonthOffset += delta;
      updateMonthLabel();
    }

    function updateMonthLabel() {
      const now = new Date();
      now.setMonth(now.getMonth() + currentMonthOffset);
      const buddhistYear = now.getFullYear() + 543;
      document.getElementById("monthLabel").textContent = `${MONTHS_TH[now.getMonth()]} ${buddhistYear}`;
    }

    function renderList() {
      const container = document.getElementById("taskListContainer");
      const allDoneState = document.getElementById("allDoneState");
      container.innerHTML = "";

      const pending = incompleteTasks.filter(t => !t.completed);

      if (pending.length === 0) {
        container.classList.add("hidden");
        allDoneState.classList.remove("hidden");
        return;
      }

      container.classList.remove("hidden");
      allDoneState.classList.add("hidden");

      pending.forEach((task, idx) => {
        const card = document.createElement("div");
        card.className = "flex items-center gap-4 p-4 sm:p-5 rounded-2xl border border-stone-200 bg-white cursor-pointer hover:border-stone-300 active:scale-[0.99] transition-all shadow-xs";
        card.onclick = () => {
          window.location.href = `/tasks/detail?id=${task.id}&from=incomplete`;
        };

        const durationText = task.duration ? task.duration : '';

        card.innerHTML = `
          <img src="${task.image}" alt="${task.title}"
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl object-cover shrink-0 border border-stone-100" />
          <div class="flex-1 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a] leading-snug">
              ${idx + 1}. ${task.title}
            </h3>
            <p class="text-lg sm:text-xl text-stone-500 font-semibold mt-0.5">${durationText}</p>
            <p class="text-xl sm:text-2xl font-extrabold text-[#1a2e1a] mt-1">${task.reps}</p>
          </div>
        `;
        container.appendChild(card);
      });
    }

    init();
  </script>
</body>

</html>