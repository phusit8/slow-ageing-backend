<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ความก้าวหน้ารายเดือน - Slow Aging</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap');

    body {
      font-family: 'Sarabun', sans-serif;
    }
  </style>
</head>

<body class="bg-white text-[#1a2e1a] min-h-screen">
  <div class="w-full max-w-md md:max-w-lg mx-auto min-h-screen flex flex-col px-5 sm:px-7 pt-6 sm:pt-8 pb-12">

    <!-- Header -->
    <div class="relative flex items-center justify-center mb-6 sm:mb-8">
      <a href="/home"
        class="absolute left-0 p-2 -ml-2 text-black cursor-pointer hover:bg-stone-100 rounded-2xl transition-colors">
        <span class="iconify text-3xl sm:text-4xl" data-icon="solar:arrow-left-outline"></span>
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1a2e1a] text-center">
        ความก้าวหน้ารายเดือน
      </h1>
    </div>

    <!-- Month Navigator -->
    <div class="flex items-center justify-center gap-6 mb-7">
      <button id="prevBtn"
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-100 hover:bg-stone-200 active:scale-95 transition-all cursor-pointer">
        <span class="iconify text-2xl text-stone-600" data-icon="solar:alt-arrow-left-outline"></span>
      </button>
      <span id="monthYearText" class="text-xl sm:text-2xl font-bold text-[#1a2e1a] min-w-[170px] text-center">
        สิงหาคม 2568
      </span>
      <button id="nextBtn"
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-stone-100 hover:bg-stone-200 active:scale-95 transition-all cursor-pointer">
        <span class="iconify text-2xl text-stone-600" data-icon="solar:alt-arrow-right-outline"></span>
      </button>
    </div>

    <!-- ความสม่ำเสมอของเดือนนี้ -->
    <div class="mb-7">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a] mb-2.5">
        ความสม่ำเสมอของเดือนนี้
      </h2>
      <div class="flex items-center gap-4">
        <span id="consistencyPercent" class="text-4xl sm:text-5xl font-extrabold text-[#1a2e1a] shrink-0">
          45%
        </span>
        <div class="flex-1 h-3.5 sm:h-4 rounded-full bg-stone-200/80 overflow-hidden">
          <div id="consistencyBar" class="h-full rounded-full bg-[#276735] transition-all duration-500"
            style="width: 45%;"></div>
        </div>
      </div>
      <p id="consistencyDesc" class="text-lg sm:text-xl text-stone-500 font-medium mt-1.5">
        ทำได้ 14 วัน จาก 31 วัน
      </p>
    </div>

    <!-- Calendar Grid -->
    <div class="mb-5">
      <!-- Weekday Headers -->
      <div class="grid grid-cols-7 mb-2">
        <div class="text-center text-lg sm:text-xl font-bold text-stone-400 py-1">อา</div>
        <div class="text-center text-lg sm:text-xl font-bold text-stone-400 py-1">จ</div>
        <div class="text-center text-lg sm:text-xl font-bold text-stone-400 py-1">อ</div>
        <div class="text-center text-lg sm:text-xl font-bold text-stone-400 py-1">พ</div>
        <div class="text-center text-lg sm:text-xl font-bold text-stone-400 py-1">พฤ</div>
        <div class="text-center text-lg sm:text-xl font-bold text-stone-400 py-1">ศ</div>
        <div class="text-center text-lg sm:text-xl font-bold text-stone-400 py-1">ส</div>
      </div>

      <!-- Days Grid -->
      <div id="calendarGrid" class="grid grid-cols-7 gap-y-2.5 text-center">
        <!-- Injected by JS -->
      </div>
    </div>
    <hr>
    <!-- Legend -->
    <div class="flex items-center justify-center gap-6 sm:gap-7 my-6 text-stone-500 text-base sm:text-lg font-medium">
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#276735]"></span>
        <span>ทำครบ</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#f59e0b]"></span>
        <span>ทำบางส่วน</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-stone-300"></span>
        <span>ไม่ได้ทำ</span>
      </div>
    </div>

    <!-- สถิติเดือนนี้ -->
    <div class="mt-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a] mb-4">
        สถิติเดือนนี้
      </h2>
      <div class="grid grid-cols-3 gap-3 sm:gap-4">

        <!-- วันทำครบ -->
        <div class="bg-[#ecfaee] rounded-3xl p-4 sm:p-5 flex flex-col items-center justify-center text-center">
          <div
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full border-2 border-[#276735] text-[#276735] flex items-center justify-center bg-white shadow-2xs">
            <span class="iconify text-2xl" data-icon="solar:check-circle-outline"></span>
          </div>
          <span id="statDone" class="text-3xl sm:text-4xl font-extrabold text-[#276735] mt-3">
            14
          </span>
          <span class="text-base sm:text-lg font-medium text-stone-600 mt-1">
            วันทำครบ
          </span>
        </div>

        <!-- วันทำบางส่วน -->
        <div class="bg-[#fffbeb] rounded-3xl p-4 sm:p-5 flex flex-col items-center justify-center text-center">
          <div
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full border-2 border-[#f59e0b] text-[#f59e0b] flex items-center justify-center bg-white shadow-2xs">
            <span class="iconify text-2xl" data-icon="solar:clock-circle-outline"></span>
          </div>
          <span id="statPartial" class="text-3xl sm:text-4xl font-extrabold text-[#d97706] mt-3">
            4
          </span>
          <span class="text-base sm:text-lg font-medium text-stone-600 mt-1">
            วันทำบางส่วน
          </span>
        </div>

        <!-- วันไม่ได้ทำ -->
        <div class="bg-[#fef2f2] rounded-3xl p-4 sm:p-5 flex flex-col items-center justify-center text-center">
          <div
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full border-2 border-[#ef4444] text-[#ef4444] flex items-center justify-center bg-white shadow-2xs">
            <span class="iconify text-2xl" data-icon="solar:close-circle-outline"></span>
          </div>
          <span id="statMissed" class="text-3xl sm:text-4xl font-extrabold text-[#ef4444] mt-3">
            0
          </span>
          <span class="text-base sm:text-lg font-medium text-stone-600 mt-1">
            วันไม่ได้ทำ
          </span>
        </div>

      </div>
    </div>

  </div>

  <script>
    const MONTH_NAMES = [
      "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
      "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม",
    ];

    const today = new Date();
    let currentMonth = today.getMonth();
    let currentYear = today.getFullYear() + 543;

    function getDaysInMonth(year, month) {
      return new Date(year - 543, month + 1, 0).getDate();
    }

    function getFirstDayOfWeek(year, month) {
      return new Date(year - 543, month, 1).getDay();
    }

    function renderCalendar() {
      document.getElementById("monthYearText").innerText = `${MONTH_NAMES[currentMonth]} ${currentYear}`;

      const totalDays = getDaysInMonth(currentYear, currentMonth);
      const startDay = getFirstDayOfWeek(currentYear, currentMonth);

      // โหลดประวัติการทำกิจกรรมจริง
      let historyMap = {};
      try {
        const savedHistory = localStorage.getItem("daily_activity_history");
        if (savedHistory) historyMap = JSON.parse(savedHistory);
      } catch (e) {}

      // ตรวจสอบวันนี้
      const isCurrentMonthNow = (currentMonth === today.getMonth() && currentYear === (today.getFullYear() + 543));
      const todayDate = today.getDate();

      const savedTodayTasks = localStorage.getItem("exercise_tasks_data");
      let todayStatus = null;
      if (savedTodayTasks) {
        try {
          const tasks = JSON.parse(savedTodayTasks);
          if (tasks.length > 0) {
            const completedCount = tasks.filter(t => t.completed).length;
            if (completedCount === tasks.length) todayStatus = "done";
            else if (completedCount > 0) todayStatus = "partial";
          }
        } catch (e) {}
      }

      let monthDays = [];
      for (let i = 1; i <= totalDays; i++) {
        let st = null;
        if (isCurrentMonthNow && i === todayDate) {
          st = todayStatus;
        } else {
          const dateKey = `${currentYear - 543}-${String(currentMonth + 1).padStart(2, '0')}-${String(i).padStart(2, '0')}`;
          if (historyMap[dateKey]) {
            st = historyMap[dateKey];
          }
        }
        monthDays.push({ day: i, status: st });
      }

      const gridContainer = document.getElementById("calendarGrid");
      gridContainer.innerHTML = "";

      // เซลล์ว่างก่อนวันที่ 1
      for (let i = 0; i < startDay; i++) {
        const emptyCell = document.createElement("div");
        emptyCell.className = "h-11 sm:h-12";
        gridContainer.appendChild(emptyCell);
      }

      // วาดวันที่
      monthDays.forEach(item => {
        const cell = document.createElement("div");
        cell.className = "flex items-center justify-center py-1";

        let circleClass = "";
        if (item.status === "done") {
          circleClass = "bg-[#276735] text-white font-extrabold";
        } else if (item.status === "partial") {
          circleClass = "bg-[#ffedd5] text-[#1a2e1a] font-bold";
        } else {
          circleClass = "text-stone-400 font-semibold";
        }

        cell.innerHTML = `
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center text-lg sm:text-xl transition-transform ${circleClass}">
            ${item.day}
          </div>
        `;
        gridContainer.appendChild(cell);
      });

      // คำนวณสถิติ
      const doneCount = monthDays.filter(d => d.status === "done").length;
      const partialCount = monthDays.filter(d => d.status === "partial").length;
      const missedCount = Math.max(0, totalDays - (doneCount + partialCount));

      const consistencyPercent = Math.round((doneCount / totalDays) * 100);

      document.getElementById("consistencyPercent").innerText = `${consistencyPercent}%`;
      document.getElementById("consistencyBar").style.width = `${consistencyPercent}%`;
      document.getElementById("consistencyDesc").innerText = `ทำได้ ${doneCount} วัน จาก ${totalDays} วัน`;

      document.getElementById("statDone").innerText = doneCount;
      document.getElementById("statPartial").innerText = partialCount;
      document.getElementById("statMissed").innerText = missedCount;
    }

    document.getElementById("prevBtn").addEventListener("click", () => {
      if (currentMonth === 0) {
        currentMonth = 11;
        currentYear--;
      } else {
        currentMonth--;
      }
      renderCalendar();
    });

    document.getElementById("nextBtn").addEventListener("click", () => {
      if (currentMonth === 11) {
        currentMonth = 0;
        currentYear++;
      } else {
        currentMonth++;
      }
      renderCalendar();
    });

    renderCalendar();
  </script>
</body>

</html>