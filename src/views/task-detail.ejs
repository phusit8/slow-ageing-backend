<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>วิธีทำท่า - Slow Aging</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Iconify -->
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap');

    body {
      font-family: 'Sarabun', sans-serif;
    }
  </style>
</head>

<body class="bg-white min-h-screen">
  <div class="w-full max-w-md md:max-w-2xl lg:max-w-3xl mx-auto min-h-screen flex flex-col justify-between px-5 sm:px-8 pt-6 sm:pt-10 pb-10">
    
    <div>
      <!-- Header -->
      <div class="relative flex items-center justify-center mb-6 sm:mb-8">
        <button id="backBtn" onclick="goBack()"
          class="absolute left-0 p-2 -ml-2 text-black cursor-pointer hover:bg-stone-200/60 rounded-2xl transition-colors">
          <span class="iconify text-3xl sm:text-4xl" data-icon="solar:arrow-left-outline"></span>
        </button>
        <h1 id="detailHeaderTitle" class="text-3xl sm:text-4xl font-extrabold text-center text-[#1a2e1a]">
          วิธีทำท่า
        </h1>
      </div>

      <!-- Mock Image Banner with Play Button (No overlay text on image) -->
      <div class="relative w-full rounded-3xl overflow-hidden mb-6 bg-stone-200 shadow-sm">
        <img id="detailImage"
          src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=800&auto=format&fit=crop&q=80"
          alt="รูปจำลองวิธีทำท่า"
          class="w-full h-60 sm:h-72 object-cover" />
        
        <!-- Play Button -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white/90 flex items-center justify-center shadow-xl">
            <span class="iconify text-4xl sm:text-5xl ml-1 text-[#2d7a3a]" data-icon="solar:play-outline"></span>
          </div>
        </div>
      </div>

      <!-- Title & Reps / Duration -->
      <div class="mb-5 px-1">
        <h2 id="detailTitle" class="text-3xl sm:text-4xl font-extrabold text-[#1a2e1a]">
          1. บริหารคอ
        </h2>
        <p id="detailReps" class="text-xl sm:text-2xl font-bold text-[#2d7a3a] mt-1.5">
          ทำ 10 ครั้ง (ประมาณ 1 นาที)
        </p>
      </div>

      <!-- วิธีทำ (Steps) -->
      <div class="mb-6 px-1">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a] mb-4">วิธีทำ</h3>
        <div id="detailSteps" class="space-y-3.5 text-xl sm:text-2xl text-stone-800 leading-relaxed font-medium">
          <!-- Steps injected by JS -->
        </div>
      </div>

      <!-- ข้อควรระวัง (Caution Box) -->
      <div class="p-4 sm:p-5 bg-[#f0faf1] rounded-2xl border border-[#c8e6c9] mb-8 flex items-start gap-3">
        <span class="iconify text-2xl text-[#2d7a3a] shrink-0 mt-0.5" data-icon="solar:lightbulb-outline"></span>
        <p id="detailCaution" class="text-base sm:text-lg text-[#2d7a3a] font-semibold leading-relaxed">
          ควรทำช้าๆ ไม่กระตุก หากรู้สึกเจ็บให้หยุดทันที
        </p>
      </div>
    </div>

    <!-- ปุ่มทำเสร็จแล้ว -->
    <div class="pt-4">
      <button id="completeBtn" onclick="toggleComplete()"
        class="w-full flex items-center justify-center gap-3 py-5 sm:py-6 rounded-2xl font-extrabold text-white text-2xl sm:text-3xl cursor-pointer active:scale-[0.98] transition-transform shadow-lg"
        style="background: #2d7a3a;">
        <span class="iconify text-3xl sm:text-4xl" data-icon="solar:check-circle-outline"></span>
        <span id="completeBtnText">ทำเสร็จแล้ว</span>
      </button>
    </div>

  </div>

  <script id="serverExerciseData" type="application/json">
    <%- JSON.stringify(typeof exercise !== 'undefined' ? exercise : null) %>
  </script>
  <script>
    const serverExercise = JSON.parse(document.getElementById('serverExerciseData')?.textContent || 'null');

    const urlParams = new URLSearchParams(window.location.search);
    const taskId = urlParams.get('id') || '1';
    const fromPage = urlParams.get('from') || 'today';

    let taskList = [];
    let currentTask = null;
    let storageKey = fromPage === 'incomplete' ? 'previous_incomplete_tasks' : 'exercise_tasks_data';

    async function init() {
      const saved = localStorage.getItem(storageKey);
      if (saved) {
        try {
          taskList = JSON.parse(saved);
        } catch (e) {
          taskList = [];
        }
      }

      if (serverExercise) {
        const firstMedia = serverExercise.media && serverExercise.media.length > 0 ? serverExercise.media[0].url : "";
        const fallbackImg = "/images/headermain.svg";
        currentTask = {
          id: serverExercise.id,
          title: serverExercise.name,
          reps: `${serverExercise.quantity} ${serverExercise.unit || 'ครั้ง'}`,
          duration: `(ประมาณ ${serverExercise.duration} ${serverExercise.duration_unit || 'นาที'})`,
          image: firstMedia || fallbackImg,
          steps: serverExercise.steps && serverExercise.steps.length > 0 
            ? serverExercise.steps.map(s => s.description) 
            : ["ปฏิบัติตามคำแนะนำของท่ากายภาพนี้"],
          caution: serverExercise.instruction || "ควรทำช้าๆ ไม่กระตุก หากรู้สึกเจ็บหรือเวียนศีรษะให้หยุดทันที",
          completed: false
        };

        const foundInStorage = taskList.find(t => String(t.id) === String(serverExercise.id));
        if (foundInStorage) {
          currentTask.completed = !!foundInStorage.completed;
        }
      } else {
        currentTask = taskList.find(t => String(t.id) === String(taskId));
        if (!currentTask) {
          try {
            const res = await fetch(`/api/exercises/${taskId}`);
            if (res.ok) {
              const ex = await res.json();
              if (ex) {
                const firstMedia = ex.media && ex.media.length > 0 ? ex.media[0].url : "";
                currentTask = {
                  id: ex.id,
                  title: ex.name,
                  reps: `${ex.quantity} ${ex.unit || 'ครั้ง'}`,
                  duration: `(ประมาณ ${ex.duration} ${ex.duration_unit || 'นาที'})`,
                  image: firstMedia || "/images/headermain.svg",
                  steps: ex.steps && ex.steps.length > 0 ? ex.steps.map(s => s.description) : ["ปฏิบัติตามคำแนะนำ"],
                  caution: ex.instruction || "ควรทำช้าๆ ไม่กระตุก หากรู้สึกเจ็บให้หยุดทันที",
                  completed: false
                };
              }
            }
          } catch (e) {
            console.error(e);
          }
        }
      }

      if (!currentTask) {
        document.getElementById("detailHeaderTitle").innerText = "ไม่พบกิจกรรม";
        document.getElementById("detailTitle").innerText = "ไม่พบข้อมูลกิจกรรมนี้";
        document.getElementById("detailReps").innerText = "";
        document.getElementById("detailCaution").innerText = "กรุณากลับไปเลือกกิจกรรมใหม่";
        document.getElementById("detailSteps").innerHTML = "<p>ไม่พบข้อมูลกิจกรรมในระบบ</p>";
        return;
      }

      const taskIndex = taskList.findIndex(t => String(t.id) === String(currentTask.id));
      const displayIndex = taskIndex >= 0 ? taskIndex + 1 : 1;

      // Header title
      document.getElementById("detailHeaderTitle").innerText = currentTask.title;

      // Image
      if (currentTask.image) {
        document.getElementById("detailImage").src = currentTask.image;
      }

      // Title & Reps
      document.getElementById("detailTitle").innerText = `${displayIndex}. ${currentTask.title}`;
      const durationText = currentTask.duration ? ` ${currentTask.duration}` : '';
      document.getElementById("detailReps").innerText = `ทำ ${currentTask.reps}${durationText}`;

      // Caution
      if (currentTask.caution) {
        document.getElementById("detailCaution").innerText = currentTask.caution;
      }

      // Steps
      const stepsContainer = document.getElementById("detailSteps");
      stepsContainer.innerHTML = (currentTask.steps || []).map((step, idx) => `
        <div class="flex items-start gap-3.5">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#2d7a3a] text-white text-lg font-extrabold flex items-center justify-center mt-0.5">
            ${idx + 1}
          </span>
          <p class="flex-1">${step.replace(/^\d+\.\s*/, '')}</p>
        </div>
      `).join('');

      // Complete button state
      updateButtonState();
    }

    function updateButtonState() {
      const btn = document.getElementById("completeBtn");
      const btnText = document.getElementById("completeBtnText");

      if (currentTask.completed && fromPage === 'today') {
        btn.style.background = "#6b7280";
        btnText.innerText = "ยกเลิก (ทำใหม่อีกครั้ง)";
      } else {
        btn.style.background = "#2d7a3a";
        btnText.innerText = "ทำเสร็จแล้ว";
      }
    }

    function toggleComplete() {
      if (!currentTask) return;

      if (fromPage === 'incomplete') {
        currentTask.completed = true;
      } else {
        currentTask.completed = !currentTask.completed;
      }

      const existingIdx = taskList.findIndex(t => String(t.id) === String(currentTask.id));
      if (existingIdx >= 0) {
        taskList[existingIdx].completed = currentTask.completed;
      } else {
        taskList.push(currentTask);
      }

      localStorage.setItem(storageKey, JSON.stringify(taskList));

      // Redirect back to list
      goBack();
    }

    function goBack() {
      if (fromPage === 'incomplete') {
        window.location.href = '/tasks/incomplete';
      } else {
        window.location.href = '/tasks';
      }
    }

    init();
  </script>
</body>

</html>
