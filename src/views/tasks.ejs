<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>กิจกรรมวันนี้ - Slow Aging</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Iconify -->
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap');
    body {
      font-family: 'Sarabun', sans-serif;
    }
  </style>
</head>
<body class="bg-white min-h-screen">

  <div class="w-full max-w-md md:max-w-2xl lg:max-w-3xl mx-auto min-h-screen flex flex-col justify-between px-5 sm:px-8 pt-6 sm:pt-10 pb-10">
    
    <div>
      <!-- Header -->
      <div class="relative flex items-center justify-center mb-6 sm:mb-8">
        <a href="/home" class="absolute left-0 p-2 -ml-2 text-black cursor-pointer hover:bg-stone-200/60 rounded-2xl transition-colors">
          <span class="iconify text-3xl sm:text-4xl" data-icon="solar:arrow-left-outline"></span>
        </a>
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1a2e1a]">กิจกรรมวันนี้</h1>
          <p id="currentThaiDate" class="text-lg sm:text-xl font-bold text-stone-700 mt-1">วันที่ -</p>
        </div>
      </div>

      <!-- Task Cards List -->
      <div id="taskListContainer" class="space-y-4 sm:space-y-5">
        <!-- Injected by JS -->
      </div>
    </div>

    <!-- Bottom Button: กิจกรรมที่ยังไม่เสร็จ -->
    <div class="pt-8">
      <a href="/tasks/incomplete" class="block w-full py-4 sm:py-5 rounded-2xl border border-stone-200 bg-[#f8faf8] hover:bg-stone-100 active:scale-[0.99] text-center text-xl sm:text-2xl font-bold text-[#d32f2f] transition-all cursor-pointer shadow-xs">
        กิจกรรมที่ยังไม่เสร็จ
      </a>
    </div>

  </div>

  <script id="serverExercisesData" type="application/json">
    <%- JSON.stringify(typeof exercises !== 'undefined' ? exercises : []) %>
  </script>
  <script>
    const serverExercises = JSON.parse(document.getElementById('serverExercisesData')?.textContent || '[]');

    let tasks = [];

    function init() {
      // วันที่ภาษาไทย
      const now = new Date();
      const months = ["มกราคม","กุมภาพันธ์","มีนาคม","เมษายน","พฤษภาคม","มิถุนายน","กรกฎาคม","สิงหาคม","กันยายน","ตุลาคม","พฤศจิกายน","ธันวาคม"];
      document.getElementById("currentThaiDate").innerText = `วันที่ ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear() + 543}`;

      // ดึงข้อมูลจริงจาก Database
      if (serverExercises && serverExercises.length > 0) {
        tasks = serverExercises.map((ex) => {
          const firstMedia = ex.media && ex.media.length > 0 ? ex.media[0].url : "";
          const img = firstMedia || "/images/headermain.svg";
          const stepsList = ex.steps && ex.steps.length > 0 
            ? ex.steps.map(s => s.description) 
            : ["ปฏิบัติตามคำแนะนำของท่ากายภาพนี้"];

          return {
            id: ex.id,
            title: ex.name,
            reps: `${ex.quantity} ${ex.unit || 'ครั้ง'}`,
            duration: `(ประมาณ ${ex.duration} ${ex.duration_unit || 'นาที'})`,
            completed: false,
            image: img,
            steps: stepsList,
            caution: ex.instruction || "ควรทำช้าๆ ไม่กระตุก หากรู้สึกเจ็บหรือเวียนศีรษะให้หยุดทันที",
            color: ex.color || "#16a34a"
          };
        });
      } else {
        tasks = [];
      }

      // ตรวจสอบสถานะการทำภารกิจที่บันทึกไว้ใน LocalStorage
      const savedTasks = localStorage.getItem("exercise_tasks_data");
      if (savedTasks) {
        try {
          const parsed = JSON.parse(savedTasks);
          tasks.forEach(t => {
            const found = parsed.find(p => String(p.id) === String(t.id));
            if (found) t.completed = !!found.completed;
          });
        } catch (e) {}
      }
      localStorage.setItem("exercise_tasks_data", JSON.stringify(tasks));

      renderTaskList();
    }

    function renderTaskList() {
      const container = document.getElementById("taskListContainer");
      container.innerHTML = "";

      if (tasks.length === 0) {
        container.innerHTML = `
          <div class="text-center py-16 px-4 bg-[#f8faf8] rounded-3xl border border-stone-200">
            <span class="iconify text-6xl text-stone-300 mx-auto mb-3" data-icon="solar:dumbbell-large-outline"></span>
            <h3 class="text-2xl font-bold text-stone-700">ยังไม่มีกิจกรรมที่เปิดใช้งาน</h3>
            <p class="text-stone-500 text-lg mt-1 font-medium">เจ้าหน้าที่จะเพิ่มกิจกรรมให้ในระบบเร็วๆ นี้</p>
          </div>
        `;
        return;
      }

      tasks.forEach((task, idx) => {
        const card = document.createElement("div");
        card.className = "flex items-center justify-between gap-4 p-4 sm:p-5 rounded-2xl border border-stone-200 bg-white cursor-pointer hover:border-stone-300 active:scale-[0.99] transition-all shadow-xs";
        card.onclick = () => {
          window.location.href = `/tasks/detail?id=${task.id}&from=today`;
        };

        const durationText = task.duration ? task.duration : '';

        card.innerHTML = `
          <div class="flex items-center gap-4 min-w-0">
            <img src="${task.image}" alt="${task.title}"
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl object-cover shrink-0 border border-stone-100 bg-stone-100" />
            <div class="min-w-0">
              <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a] leading-snug truncate">
                ${idx + 1}. ${task.title}
              </h3>
              <p class="text-lg sm:text-xl text-stone-500 font-semibold mt-0.5">${durationText}</p>
              <p class="text-xl sm:text-2xl font-extrabold text-[#1a2e1a] mt-1">${task.reps}</p>
            </div>
          </div>
          <div class="shrink-0 pr-2">
            ${task.completed 
              ? '<span class="iconify text-3xl sm:text-4xl text-emerald-600" data-icon="solar:check-circle-outline"></span>' 
              : ''
            }
          </div>
        `;
        container.appendChild(card);
      });
    }

    init();
  </script>
</body>
</html>
