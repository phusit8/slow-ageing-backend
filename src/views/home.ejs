<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>หน้าหลัก - Slow Aging</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Iconify -->
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <!-- LIFF SDK -->
  <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap');
    body {
      font-family: 'Prompt', sans-serif;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-start items-center py-6 sm:py-8 px-4 sm:px-6" style="background-color: #f5f7f5;">

  <!-- Container -->
  <div class="w-full max-w-md sm:max-w-lg md:max-w-xl mx-auto flex flex-col space-y-6 sm:space-y-7 pb-16">
    
    <!-- Top Header -->
    <header class="flex items-center justify-between pt-2 pb-1">
      <div class="flex items-center gap-3">
        <span id="greetingIcon" class="text-4xl sm:text-5xl text-amber-500">☀️</span>
        <h1 id="greetingText" class="text-3xl sm:text-4xl font-extrabold tracking-tight" style="color: #1a2e1a;">
          สวัสดีตอนเช้า
        </h1>
      </div>

      <a href="/profile" class="flex items-center gap-2 px-5 py-3 rounded-2xl text-white text-lg sm:text-xl font-bold shadow-md hover:opacity-95 active:scale-95 transition-transform cursor-pointer" style="background: #2d7a3a;">
        <span class="iconify text-2xl" data-icon="mdi:account-circle-outline"></span>
        <span>โปรไฟล์</span>
      </a>
    </header>

    <!-- User Card -->
    <div class="flex items-center gap-5 py-3 px-2 bg-white/60 rounded-3xl border border-stone-200/60">
      <img
        id="userPicture"
        src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=200&auto=format&fit=crop&q=80"
        alt="Profile"
        class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover shadow-md border-4 border-white ring-4 ring-emerald-100 flex-shrink-0"
      />
      <div class="flex flex-col space-y-1">
        <h2 id="userName" class="text-2xl sm:text-3xl md:text-4xl font-extrabold leading-tight" style="color: #1a2e1a;">
          คุณยายสมศรี
        </h2>
        <div class="flex items-center gap-2 text-lg sm:text-xl font-bold" style="color: #2d7a3a;">
          <span class="iconify text-2xl shrink-0" data-icon="mdi:map-marker-outline"></span>
          <span id="userVillage">ชุมชนบ้านสุขใจ</span>
        </div>
        <div class="flex items-center gap-2 text-base sm:text-lg font-semibold" style="color: #4a5d4e;">
          <span class="iconify text-xl shrink-0" data-icon="mdi:calendar-month-outline"></span>
          <span id="currentThaiDate">-</span>
        </div>
      </div>
    </div>

    <!-- Progress Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-sm border border-stone-200">
      <h3 class="text-2xl sm:text-3xl font-extrabold mb-5 text-[#1a2e1a]">
        ความก้าวหน้าวันนี้
      </h3>

      <div class="flex items-center justify-between gap-5 sm:gap-7">
        
        <!-- ฝั่งซ้าย: วงกลม Progress -->
        <div class="relative w-32 h-32 sm:w-36 sm:h-36 flex items-center justify-center shrink-0">
          <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="38" fill="transparent" stroke="#e2f5e8" stroke-width="12" />
            <circle
              id="progressCircle"
              cx="50"
              cy="50"
              r="38"
              fill="transparent"
              stroke="#2d7a3a"
              stroke-width="12"
              stroke-dasharray="238.7"
              stroke-dashoffset="238.7"
              stroke-linecap="round"
              class="transition-all duration-700 ease-out"
            />
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="text-3xl sm:text-4xl font-extrabold text-[#1a2e1a]">
              <span id="progressPercentText">0</span><span class="text-xl sm:text-2xl">%</span>
            </span>
          </div>
        </div>

        <!-- ฝั่งขวา: สถิติและปุ่ม -->
        <div class="flex-1 flex flex-col justify-center space-y-3 pl-1">
          <div>
            <span class="text-xl sm:text-2xl font-bold block text-[#1a2e1a] leading-tight">
              ทำภารกิจแล้ว
            </span>
            <span class="text-xl sm:text-2xl font-extrabold block text-[#2d7a3a] mt-1">
              <span id="completedTasksText">0</span> จาก <span id="totalTasksText">4</span> ท่า
            </span>
          </div>

          <a href="/tasks" class="flex items-center justify-between px-5 sm:px-6 py-3.5 sm:py-4 rounded-2xl text-white text-lg sm:text-xl font-extrabold shadow-md hover:opacity-95 active:scale-95 transition-transform cursor-pointer w-full gap-2" style="background: #2d7a3a;">
            <span>ดูภารกิจวันนี้</span>
            <span class="iconify text-2xl" data-icon="mdi:chevron-right"></span>
          </a>
        </div>

      </div>
    </div>

    <!-- Action Menu Cards List -->
    <div class="space-y-4 pt-1">
      
      <!-- Card 1 -->
      <a href="/tasks" class="group flex items-center justify-between p-5 sm:p-6 rounded-3xl bg-white shadow-sm border border-stone-200 hover:border-emerald-300 transition-all cursor-pointer active:scale-[0.99] block">
        <div class="flex items-center gap-4 sm:gap-5">
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-xs" style="background: #eef6ff;">
            <span class="iconify text-3xl sm:text-4xl" data-icon="mdi:dumbbell" style="color: #0066cc;"></span>
          </div>
          <div>
            <h4 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a]">ภารกิจวันนี้</h4>
            <p class="text-base sm:text-lg text-stone-600 font-semibold mt-1">ออกกำลังกายและกิจกรรมเพื่อสุขภาพ</p>
          </div>
        </div>
        <span class="iconify text-3xl text-stone-400 group-hover:text-stone-800 transition-colors shrink-0 ml-2" data-icon="mdi:chevron-right"></span>
      </a>

      <!-- Card 2 -->
      <a href="/calendar" class="group flex items-center justify-between p-5 sm:p-6 rounded-3xl bg-white shadow-sm border border-stone-200 hover:border-emerald-300 transition-all cursor-pointer active:scale-[0.99] block">
        <div class="flex items-center gap-4 sm:gap-5">
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-xs" style="background: #f2f9ed;">
            <span class="iconify text-3xl sm:text-4xl" data-icon="mdi:calendar-month-outline" style="color: #438e12;"></span>
          </div>
          <div>
            <h4 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a]">ปฏิทินรายเดือน</h4>
            <p class="text-base sm:text-lg text-stone-600 font-semibold mt-1">ดูตารางกิจกรรมประจำเดือน</p>
          </div>
        </div>
        <span class="iconify text-3xl text-stone-400 group-hover:text-stone-800 transition-colors shrink-0 ml-2" data-icon="mdi:chevron-right"></span>
      </a>

      <!-- Card 3 -->
      <a href="/progress" class="group flex items-center justify-between p-5 sm:p-6 rounded-3xl bg-white shadow-sm border border-stone-200 hover:border-emerald-300 transition-all cursor-pointer active:scale-[0.99] block">
        <div class="flex items-center gap-4 sm:gap-5">
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-xs" style="background: #eef6ff;">
            <span class="iconify text-3xl sm:text-4xl" data-icon="mdi:chart-box-outline" style="color: #0066cc;"></span>
          </div>
          <div>
            <h4 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a]">ความก้าวหน้า</h4>
            <p class="text-base sm:text-lg text-stone-600 font-semibold mt-1">ดูสถิติและความก้าวหน้าของท่าน</p>
          </div>
        </div>
        <span class="iconify text-3xl text-stone-400 group-hover:text-stone-800 transition-colors shrink-0 ml-2" data-icon="mdi:chevron-right"></span>
      </a>

    </div>
  </div>

  <script>
    // ตัวแปร Default
    let totalTasks = 4;
    let completedTasksCount = 3;
    
    // ตั้งค่าเวลาทักทายและวันที่ภาษาไทย
    function setDateAndGreeting() {
      const now = new Date();
      const days = ["อาทิตย์", "จันทร์", "อังคาร", "พุธ", "พฤหัสบดี", "ศุกร์", "เสาร์"];
      const months = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];

      const dayName = days[now.getDay()];
      const dateNum = now.getDate();
      const monthName = months[now.getMonth()];
      const thaiYear = now.getFullYear() + 543;

      document.getElementById("currentThaiDate").innerText = `วัน${dayName}ที่ ${dateNum} ${monthName} ${thaiYear}`;

      const hour = now.getHours();
      let greeting = "สวัสดีตอนเช้า";
      let icon = "☀️";

      if (hour >= 12 && hour < 17) {
        greeting = "สวัสดีตอนบ่าย";
        icon = "🌤️";
      } else if (hour >= 17 && hour < 21) {
        greeting = "สวัสดีตอนเย็น";
        icon = "🌅";
      } else if (hour >= 21 || hour < 6) {
        greeting = "สวัสดีตอนค่ำ";
        icon = "🌙";
      }

      document.getElementById("greetingIcon").innerText = icon;
      document.getElementById("greetingText").innerText = greeting;
    }

    // อัปเดต Progress Bar
    function updateProgress(completed, total) {
      const percent = Math.round((completed / total) * 100);
      document.getElementById("progressPercentText").innerText = percent;
      document.getElementById("completedTasksText").innerText = completed;
      document.getElementById("totalTasksText").innerText = total;

      const circle = document.getElementById("progressCircle");
      const radius = 38;
      const circumference = 2 * Math.PI * radius; // ~238.76
      const offset = circumference - (percent / 100) * circumference;

      circle.style.strokeDashoffset = offset;
    }

    // 🔴 กำหนด LIFF ID 
    const LIFF_ID = "<%= LIFF_ID %>";

    async function initData() {
      // 1. จัดการวันที่และทักทาย
      setDateAndGreeting();

      // 2. ดึงข้อมูลจาก LocalStorage
      const savedProfile = localStorage.getItem("user_profile_data");
      if (savedProfile) {
        try {
          const profile = JSON.parse(savedProfile);
          if (profile.profileName) document.getElementById("userName").innerText = profile.profileName;
          if (profile.profileVillage) document.getElementById("userVillage").innerText = profile.profileVillage;
          if (profile.pictureUrl) document.getElementById("userPicture").src = profile.pictureUrl;
        } catch (e) {
          console.error("Parse profile error", e);
        }
      }

      // 3. ดึงความก้าวหน้าของภารกิจวันนี้
      const savedTasks = localStorage.getItem("exercise_tasks_data");
      if (savedTasks) {
        try {
          const tasks = JSON.parse(savedTasks);
          totalTasks = tasks.length;
          completedTasksCount = tasks.filter(t => t.completed).length;
        } catch (e) {
          console.error("Parse tasks error", e);
        }
      }

      updateProgress(completedTasksCount, totalTasks);

      // 4. เชื่อมต่อ LIFF (ถ้ามีข้อมูลรูปใหม่)
      try {
        await liff.init({ liffId: LIFF_ID });
        if (liff.isLoggedIn()) {
          const lineProfile = await liff.getProfile();
          if (lineProfile.pictureUrl && (!savedProfile || !JSON.parse(savedProfile).pictureUrl)) {
            document.getElementById("userPicture").src = lineProfile.pictureUrl;
          }
        }
      } catch (err) {
        console.error("LIFF Init Error:", err);
      }
    }

    initData();
  </script>
</body>
</html>
