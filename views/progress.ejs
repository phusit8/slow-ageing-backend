<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ความก้าวหน้า - Slow Aging</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Prompt', sans-serif; }
    
    /* Custom Dropdown Animation */
    .dropdown-menu {
      transform-origin: top right;
      transition: all 0.18s ease-out;
    }
    .dropdown-menu.hidden {
      opacity: 0;
      transform: scale(0.95) translateY(-4px);
      pointer-events: none;
    }
    .dropdown-menu:not(.hidden) {
      opacity: 1;
      transform: scale(1) translateY(0);
      pointer-events: auto;
    }
  </style>
</head>
<body class="bg-white sm:bg-[#f8faf8] text-[#1a2e1a] antialiased">
  <div class="flex flex-col min-h-screen w-full">
    <div class="w-full max-w-md sm:max-w-lg mx-auto flex-1 flex flex-col px-4 pt-5 pb-12 space-y-4 sm:space-y-4.5">

      <!-- Header -->
      <div class="relative flex items-center justify-center py-2 mb-1">
        <a href="/home" class="absolute left-0 p-1.5 -ml-1 text-black cursor-pointer hover:bg-stone-100 rounded-2xl transition-colors">
          <span class="iconify text-2xl sm:text-3xl" data-icon="mdi:arrow-left"></span>
        </a>
        <h1 class="text-xl sm:text-2xl font-bold text-black tracking-tight">ความก้าวหน้า</h1>
      </div>

      <!-- =========================================================
           Card 1: ความสำเร็จโดยรวม
           ========================================================= -->
      <div class="bg-white rounded-3xl p-5 sm:p-6 border border-stone-200 shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-black mb-4">ความสำเร็จโดยรวม</h2>
        
        <div class="flex items-center gap-6 pl-2">
          <!-- Donut Progress Circle -->
          <div class="relative w-28 h-28 sm:w-32 sm:h-32 shrink-0">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#e6f4ea" stroke-width="11" />
              <circle
                id="overallCircle"
                cx="50"
                cy="50"
                r="38"
                fill="transparent"
                stroke="#1e6b32"
                stroke-width="11"
                stroke-dasharray="238.76"
                stroke-dashoffset="52.5"
                stroke-linecap="round"
                class="transition-all duration-700 ease-out"
              />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-2xl sm:text-3xl font-extrabold text-black">
                <span id="overallPercent">78</span><span class="text-base sm:text-lg font-bold">%</span>
              </span>
            </div>
          </div>

          <!-- Stats Text -->
          <div class="space-y-0.5">
            <p class="text-2xl sm:text-3xl font-bold text-[#1e6b32]">
              ทำได้ <span id="daysCompleted">24</span> วัน
            </p>
            <p class="text-sm sm:text-base font-medium text-stone-500">
              จาก <span id="totalDays">31</span> วัน
            </p>
          </div>
        </div>
      </div>

      <!-- =========================================================
           Card 2: กราฟรายเดือน
           ========================================================= -->
      <div class="bg-white rounded-3xl p-5 sm:p-6 border border-stone-200 shadow-xs">
        <!-- Header with Dropdown -->
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg sm:text-xl font-bold text-black">กราฟรายเดือน</h2>
          
          <!-- Month Dropdown -->
          <div class="relative" id="monthDropdownWrapper">
            <button
              type="button"
              onclick="toggleMonthDropdown()"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-stone-200 bg-white hover:bg-stone-50 text-xs sm:text-sm font-semibold text-stone-700 cursor-pointer shadow-2xs transition-all"
            >
              <span class="iconify text-base text-stone-500" data-icon="mdi:calendar-outline"></span>
              <span id="selectedMonthText">สิงหาคม 2569</span>
              <span class="iconify text-base text-stone-400" data-icon="mdi:chevron-down"></span>
            </button>

            <!-- Month Dropdown Menu -->
            <div
              id="monthDropdownMenu"
              class="dropdown-menu hidden absolute right-0 mt-1.5 w-44 bg-white rounded-xl border border-stone-200 shadow-lg overflow-hidden z-50 p-1"
            >
              <button onclick="selectMonth('สิงหาคม', 'สิงหาคม 2569')" class="w-full text-left px-3 py-2 text-sm font-semibold rounded-lg hover:bg-emerald-50 text-stone-800">สิงหาคม 2569</button>
              <button onclick="selectMonth('กรกฎาคม', 'กรกฎาคม 2569')" class="w-full text-left px-3 py-2 text-sm font-semibold rounded-lg hover:bg-emerald-50 text-stone-800">กรกฎาคม 2569</button>
              <button onclick="selectMonth('มิถุนายน', 'มิถุนายน 2569')" class="w-full text-left px-3 py-2 text-sm font-semibold rounded-lg hover:bg-emerald-50 text-stone-800">มิถุนายน 2569</button>
            </div>
          </div>
        </div>

        <!-- Chart Grid with Target 75% Line -->
        <div class="relative">
          <!-- 75% Target Dashed Line -->
          <div class="absolute left-8 sm:left-9 right-0 top-[25%] border-b border-dashed border-[#78b348] z-0 pointer-events-none"></div>

          <!-- Chart Area -->
          <div class="flex gap-2">
            <!-- Y-Axis Labels -->
            <div class="flex flex-col justify-between text-[10px] sm:text-xs text-stone-400 font-medium py-0.5 text-right w-7 sm:w-8 shrink-0" style="height: 120px;">
              <span>100%</span>
              <span>75%</span>
              <span>50%</span>
              <span>25%</span>
              <span>0%</span>
            </div>

            <!-- Vertical Bars Container -->
            <div id="dailyChartBars" class="flex-1 flex items-end gap-[2px] sm:gap-[3px] z-10" style="height: 120px;">
              <!-- Injected by JS -->
            </div>
          </div>

          <!-- Bottom X-Axis Days Labels -->
          <div class="flex justify-between ml-9 sm:ml-10 mt-1 text-[10px] sm:text-xs text-stone-400 font-medium">
            <span>1</span>
            <span>5</span>
            <span>10</span>
            <span>15</span>
            <span>20</span>
            <span>25</span>
            <span>30</span>
          </div>
        </div>

        <!-- Bottom Highlight Box -->
        <div class="flex items-center gap-2 mt-4 px-3.5 py-2.5 bg-[#eaf5eb] rounded-2xl">
          <span class="text-base">📈</span>
          <span class="text-xs sm:text-sm font-bold text-[#1e6b32]" id="monthlyAvgText">
            ค่าเฉลี่ยความสำเร็จของเดือนนี้: 78%
          </span>
        </div>
      </div>

      <!-- =========================================================
           Card 3: กราฟรายปี
           ========================================================= -->
      <div class="bg-white rounded-3xl p-5 sm:p-6 border border-stone-200 shadow-xs">
        <!-- Header with Dropdown -->
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg sm:text-xl font-bold text-black">กราฟรายปี</h2>
          
          <!-- Year Dropdown -->
          <div class="relative" id="yearDropdownWrapper">
            <button
              type="button"
              onclick="toggleYearDropdown()"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-stone-200 bg-white hover:bg-stone-50 text-xs sm:text-sm font-semibold text-stone-700 cursor-pointer shadow-2xs transition-all"
            >
              <span class="iconify text-base text-stone-500" data-icon="mdi:calendar-outline"></span>
              <span id="selectedYearText">2569</span>
              <span class="iconify text-base text-stone-400" data-icon="mdi:chevron-down"></span>
            </button>

            <!-- Year Dropdown Menu -->
            <div
              id="yearDropdownMenu"
              class="dropdown-menu hidden absolute right-0 mt-1.5 w-32 bg-white rounded-xl border border-stone-200 shadow-lg overflow-hidden z-50 p-1"
            >
              <button onclick="selectYear('2569')" class="w-full text-left px-3 py-2 text-sm font-semibold rounded-lg hover:bg-emerald-50 text-stone-800">2569</button>
              <button onclick="selectYear('2568')" class="w-full text-left px-3 py-2 text-sm font-semibold rounded-lg hover:bg-emerald-50 text-stone-800">2568</button>
            </div>
          </div>
        </div>

        <!-- Chart Grid with Target 75% Line -->
        <div class="relative">
          <!-- 75% Target Dashed Line -->
          <div class="absolute left-8 sm:left-9 right-0 top-[25%] border-b border-dashed border-[#78b348] z-0 pointer-events-none"></div>

          <!-- Chart Area -->
          <div class="flex gap-2">
            <!-- Y-Axis Labels -->
            <div class="flex flex-col justify-between text-[10px] sm:text-xs text-stone-400 font-medium py-0.5 text-right w-7 sm:w-8 shrink-0" style="height: 120px;">
              <span>100%</span>
              <span>75%</span>
              <span>50%</span>
              <span>25%</span>
              <span>0%</span>
            </div>

            <!-- Monthly Bars Container -->
            <div id="yearlyChartBars" class="flex-1 flex items-end gap-1 sm:gap-1.5 z-10" style="height: 120px;">
              <!-- Injected by JS -->
            </div>
          </div>

          <!-- Bottom X-Axis Months Labels -->
          <div id="yearlyChartLabels" class="flex ml-9 sm:ml-10 mt-1 text-[10px] text-stone-400 font-medium">
            <!-- Injected by JS -->
          </div>
        </div>

        <!-- Bottom Highlight Box -->
        <div class="flex items-center gap-2 mt-4 px-3.5 py-2.5 bg-[#fff8e7] rounded-2xl">
          <span class="text-base text-amber-500">⭐</span>
          <span class="text-xs sm:text-sm font-bold text-[#8f6412]">
            เดือนที่ดีที่สุด: กรกฎาคม (86%)
          </span>
        </div>
      </div>

      <!-- =========================================================
           Card 4: สถิติของคุณ (3 Columns)
           ========================================================= -->
      <div class="bg-white rounded-3xl p-5 sm:p-6 border border-stone-200 shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-black mb-3.5">สถิติของคุณ</h2>
        
        <div class="grid grid-cols-3 gap-2.5 sm:gap-3">
          <!-- Done Card -->
          <div class="flex flex-col items-center justify-center py-4 px-2 rounded-2xl bg-[#eaf7ee]">
            <div class="w-7 h-7 rounded-full bg-white flex items-center justify-center shadow-2xs mb-2">
              <span class="iconify text-lg text-[#1e6b32]" data-icon="mdi:check-circle"></span>
            </div>
            <span class="text-2xl sm:text-3xl font-extrabold text-[#1e6b32]">24</span>
            <span class="text-xs sm:text-sm font-medium text-stone-600 mt-0.5">วันที่ทำครบ</span>
          </div>

          <!-- Partial Card -->
          <div class="flex flex-col items-center justify-center py-4 px-2 rounded-2xl bg-[#fff7e6]">
            <div class="w-7 h-7 rounded-full bg-white flex items-center justify-center shadow-2xs mb-2">
              <span class="iconify text-lg text-[#d97706]" data-icon="mdi:clock-time-four-outline"></span>
            </div>
            <span class="text-2xl sm:text-3xl font-extrabold text-[#b45309]">4</span>
            <span class="text-xs sm:text-sm font-medium text-stone-600 mt-0.5">วันที่ทำบางส่วน</span>
          </div>

          <!-- Missed Card -->
          <div class="flex flex-col items-center justify-center py-4 px-2 rounded-2xl bg-[#fdeeed]">
            <div class="w-7 h-7 rounded-full bg-white flex items-center justify-center shadow-2xs mb-2">
              <span class="iconify text-lg text-[#dc2626]" data-icon="mdi:close-circle-outline"></span>
            </div>
            <span class="text-2xl sm:text-3xl font-extrabold text-[#dc2626]">3</span>
            <span class="text-xs sm:text-sm font-medium text-stone-600 mt-0.5">วันที่ไม่ได้ทำ</span>
          </div>
        </div>
      </div>

      <!-- =========================================================
           Card 5: สถิติการทำต่อเนื่อง (2 Columns)
           ========================================================= -->
      <div class="bg-white rounded-3xl p-5 sm:p-6 border border-stone-200 shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-black mb-3.5">สถิติการทำต่อเนื่อง</h2>
        
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <!-- Streak Now -->
          <div class="py-4 px-4 rounded-2xl bg-[#fffbf2] text-center">
            <p class="text-xs sm:text-sm font-medium text-stone-500 mb-1.5">ทำต่อเนื่องตอนนี้</p>
            <p class="text-xl sm:text-2xl font-bold text-[#f59e0b]">7 วัน</p>
          </div>

          <!-- Max Streak -->
          <div class="py-4 px-4 rounded-2xl bg-[#eaf7ee] text-center">
            <p class="text-xs sm:text-sm font-medium text-stone-500 mb-1.5">ทำต่อเนื่องสูงสุด</p>
            <p class="text-xl sm:text-2xl font-bold text-[#1e6b32]">24 วัน</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script>
    // ข้อมูลรายเดือน
    const MONTHLY_RAW_DATA = {
      "สิงหาคม": [
        80, 70, 90, 75, 80, 85, 30, 90, 95, 78, 
        55, 88, 80, 100, 78, 72, 80, 75, 68, 82, 
        75, 50, 62, 78, 80, 0, 0, 0, 0, 0
      ],
      "กรกฎาคม": [
        85, 90, 80, 100, 75, 85, 90, 100, 80, 70,
        90, 85, 100, 75, 85, 90, 80, 100, 85, 70,
        95, 80, 90, 85, 100, 75, 90, 85, 100, 90, 85
      ],
      "มิถุนายน": [
        70, 75, 80, 60, 85, 70, 75, 90, 60, 50,
        75, 80, 70, 90, 65, 80, 60, 85, 75, 65,
        90, 70, 80, 85, 60, 90, 75, 65, 85, 80
      ]
    };

    // ข้อมูลรายปี (12 เดือน)
    const YEARLY_DATA = [
      { label: "ม.ค.", value: 75 },
      { label: "ก.พ.", value: 82 },
      { label: "มี.ค.", value: 72 },
      { label: "เม.ย.", value: 80 },
      { label: "พ.ค.", value: 78 },
      { label: "มิ.ย.", value: 81 },
      { label: "ก.ค.", value: 86, isBest: true },
      { label: "ส.ค.", value: 78 },
      { label: "ก.ย.", value: 0 },
      { label: "ต.ค.", value: 0 },
      { label: "พ.ย.", value: 0 },
      { label: "ธ.ค.", value: 0 },
    ];

    let currentMonth = "สิงหาคม";
    let currentYear = "2569";

    // Toggle Dropdowns
    function toggleMonthDropdown() {
      const menu = document.getElementById("monthDropdownMenu");
      menu.classList.toggle("hidden");
      document.getElementById("yearDropdownMenu").classList.add("hidden");
    }

    function toggleYearDropdown() {
      const menu = document.getElementById("yearDropdownMenu");
      menu.classList.toggle("hidden");
      document.getElementById("monthDropdownMenu").classList.add("hidden");
    }

    function selectMonth(key, label) {
      currentMonth = key;
      document.getElementById("selectedMonthText").innerText = label;
      document.getElementById("monthDropdownMenu").classList.add("hidden");
      renderMonthlyChart();
    }

    function selectYear(year) {
      currentYear = year;
      document.getElementById("selectedYearText").innerText = year;
      document.getElementById("yearDropdownMenu").classList.add("hidden");
      renderYearlyChart();
    }

    // ปิด dropdown เมื่อคลิกข้างนอก
    document.addEventListener("click", (e) => {
      const monthWrapper = document.getElementById("monthDropdownWrapper");
      const yearWrapper = document.getElementById("yearDropdownWrapper");
      if (monthWrapper && !monthWrapper.contains(e.target)) {
        document.getElementById("monthDropdownMenu").classList.add("hidden");
      }
      if (yearWrapper && !yearWrapper.contains(e.target)) {
        document.getElementById("yearDropdownMenu").classList.add("hidden");
      }
    });

    // วาดกราฟรายเดือน
    function renderMonthlyChart() {
      const container = document.getElementById("dailyChartBars");
      container.innerHTML = "";
      const data = MONTHLY_RAW_DATA[currentMonth] || MONTHLY_RAW_DATA["สิงหาคม"];

      data.forEach(val => {
        const bar = document.createElement("div");
        bar.className = "flex-1 rounded-t-xs transition-all duration-500";
        bar.style.height = `${val}%`;
        bar.style.backgroundColor = val > 0 ? "#1e6b32" : "transparent";
        container.appendChild(bar);
      });

      const validValues = data.filter(v => v > 0);
      const avg = Math.round(validValues.reduce((a, b) => a + b, 0) / validValues.length);
      document.getElementById("monthlyAvgText").innerText = `ค่าเฉลี่ยความสำเร็จของเดือนนี้: ${avg}%`;
    }

    // วาดกราฟรายปี
    function renderYearlyChart() {
      const container = document.getElementById("yearlyChartBars");
      const labelsContainer = document.getElementById("yearlyChartLabels");
      container.innerHTML = "";
      labelsContainer.innerHTML = "";

      YEARLY_DATA.forEach(item => {
        // Bar
        const bar = document.createElement("div");
        bar.className = "flex-1 rounded-t-md transition-all duration-500";
        bar.style.height = `${item.value}%`;
        bar.style.backgroundColor = item.isBest ? "#5db36a" : item.value > 0 ? "#1e6b32" : "transparent";
        container.appendChild(bar);

        // Label
        const label = document.createElement("span");
        label.className = "flex-1 text-center text-[10px] text-stone-500 font-medium";
        label.innerText = item.label;
        labelsContainer.appendChild(label);
      });
    }

    // เริ่มต้นแสดงผล
    renderMonthlyChart();
    renderYearlyChart();
  </script>
</body>
</html>
