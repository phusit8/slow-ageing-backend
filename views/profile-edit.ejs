<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>แก้ไขข้อมูลส่วนตัว - Slow Aging</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap');
    body { font-family: 'Prompt', sans-serif; }
  </style>
</head>
<body class="bg-white">
  <div class="flex flex-col min-h-screen w-full">
    <div class="w-full max-w-md sm:max-w-lg md:max-w-xl mx-auto flex-1 flex flex-col px-5 pt-5 pb-6">

      <!-- Header -->
      <div class="relative flex items-center justify-center mb-5">
        <a href="/profile" class="absolute left-0 p-1 -ml-1 text-black cursor-pointer hover:bg-stone-100 rounded-xl transition-colors">
          <span class="iconify text-2xl" data-icon="mdi:arrow-left"></span>
        </a>
        <h1 class="text-xl font-bold text-black">แก้ไขข้อมูลส่วนตัว</h1>
      </div>

      <!-- Avatar -->
      <div class="flex flex-col items-center mb-5" id="avatarContainer">
        <div class="w-20 h-20 rounded-full flex items-center justify-center shadow-md ring-4 ring-emerald-100" style="background: #d4edda;">
          <span class="iconify text-5xl text-[#2d7a3a]" data-icon="mdi:account-circle"></span>
        </div>
      </div>

      <!-- ฟอร์มแก้ไข -->
      <div class="space-y-4 flex-1">
        
        <div>
          <label class="text-base font-bold text-[#1a2e1a] block mb-1.5">ชื่อ-นามสกุล <span class="text-red-500">*</span></label>
          <input type="text" id="profileName" class="w-full px-4 py-3 rounded-xl border-2 text-base focus:outline-none focus:ring-2 focus:ring-[#2d7a3a] font-medium" style="border-color: #d1ded1; background: #f9fbf9; color: #1a2e1a;" placeholder="กรอกชื่อและนามสกุล" />
        </div>

        <div>
          <label class="text-base font-bold text-[#1a2e1a] block mb-1.5">ชุมชน / หมู่บ้าน <span class="text-red-500">*</span></label>
          <div class="relative">
            <select id="profileVillage" class="w-full px-4 py-3 rounded-xl border-2 text-base focus:outline-none focus:ring-2 focus:ring-[#2d7a3a] transition-all font-medium appearance-none cursor-pointer" style="border-color: #d1ded1; background: #f9fbf9; color: #1a2e1a;">
              <option value="" disabled selected>- เลือกชุมชน -</option>
              <option value="ชุมชนบ้านสุขใจ">ชุมชนบ้านสุขใจ</option>
              <option value="ชุมชนรักษ์ป่า">ชุมชนรักษ์ป่า</option>
              <option value="ชุมชนพัฒนา">ชุมชนพัฒนา</option>
              <option value="ชุมชนมิตรภาพ">ชุมชนมิตรภาพ</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-stone-500">
              <span class="iconify text-2xl" data-icon="mdi:chevron-down"></span>
            </div>
          </div>
        </div>

        <div>
          <label class="text-base font-bold text-[#1a2e1a] block mb-1.5">วันเกิด</label>
          <input type="text" id="birthday" class="w-full px-4 py-3 rounded-xl border-2 text-base focus:outline-none focus:ring-2 focus:ring-[#2d7a3a] font-medium" style="border-color: #d1ded1; background: #f9fbf9; color: #1a2e1a;" placeholder="เช่น 15 พฤษภาคม 2490" />
        </div>

        <div>
          <label class="text-base font-bold text-[#1a2e1a] block mb-1.5">เพศ</label>
          <div class="relative">
            <select id="gender" class="w-full px-4 py-3 rounded-xl border-2 text-base focus:outline-none focus:ring-2 focus:ring-[#2d7a3a] transition-all font-medium appearance-none cursor-pointer" style="border-color: #d1ded1; background: #f9fbf9; color: #1a2e1a;">
              <option value="" disabled selected>- เลือกเพศ -</option>
              <option value="ชาย">ชาย</option>
              <option value="หญิง">หญิง</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-stone-500">
              <span class="iconify text-2xl" data-icon="mdi:chevron-down"></span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-base font-bold text-[#1a2e1a] block mb-1.5">ส่วนสูง (ซม.)</label>
            <input type="text" id="height" class="w-full px-4 py-3 rounded-xl border-2 text-base focus:outline-none focus:ring-2 focus:ring-[#2d7a3a] font-medium" style="border-color: #d1ded1; background: #f9fbf9; color: #1a2e1a;" placeholder="158" />
          </div>
          <div>
            <label class="text-base font-bold text-[#1a2e1a] block mb-1.5">น้ำหนัก (กก.)</label>
            <input type="text" id="weight" class="w-full px-4 py-3 rounded-xl border-2 text-base focus:outline-none focus:ring-2 focus:ring-[#2d7a3a] font-medium" style="border-color: #d1ded1; background: #f9fbf9; color: #1a2e1a;" placeholder="58" />
          </div>
        </div>

        <div>
          <label class="text-base font-bold text-[#1a2e1a] block mb-1.5">โรคประจำตัว</label>
          <input type="text" id="disease" class="w-full px-4 py-3 rounded-xl border-2 text-base focus:outline-none focus:ring-2 focus:ring-[#2d7a3a] font-medium" style="border-color: #d1ded1; background: #f9fbf9; color: #1a2e1a;" placeholder="เช่น ความดันโลหิตสูง หรือ ไม่มี" />
        </div>

        <div>
          <label class="text-base font-bold text-[#1a2e1a] block mb-1.5">การแพ้ยา</label>
          <input type="text" id="allergy" class="w-full px-4 py-3 rounded-xl border-2 text-base focus:outline-none focus:ring-2 focus:ring-[#2d7a3a] font-medium" style="border-color: #d1ded1; background: #f9fbf9; color: #1a2e1a;" placeholder="เช่น แอสไพริน หรือ ไม่มี" />
        </div>

      </div>

      <!-- ปุ่มบันทึก -->
      <div class="pt-5">
        <button id="saveBtn" disabled class="w-full flex items-center justify-center gap-2 py-3.5 rounded-2xl font-bold text-white text-lg transition-all shadow-md cursor-not-allowed opacity-50" style="background: #2d7a3a;">
          <span class="iconify text-xl" data-icon="mdi:check"></span>
          <span id="saveBtnText">บันทึกข้อมูล</span>
        </button>
      </div>

    </div>
  </div>

  <script>
    const inputs = {
      profileName: document.getElementById("profileName"),
      profileVillage: document.getElementById("profileVillage"),
      birthday: document.getElementById("birthday"),
      gender: document.getElementById("gender"),
      height: document.getElementById("height"),
      weight: document.getElementById("weight"),
      disease: document.getElementById("disease"),
      allergy: document.getElementById("allergy")
    };
    const saveBtn = document.getElementById("saveBtn");
    const saveBtnText = document.getElementById("saveBtnText");
    const avatarContainer = document.getElementById("avatarContainer");

    const LIFF_ID = "<%= LIFF_ID %>";

    async function init() {
      // Load existing data
      const savedData = localStorage.getItem("user_profile_data");
      if (savedData) {
        try {
          const parsed = JSON.parse(savedData);
          if (parsed.profileName) inputs.profileName.value = parsed.profileName;
          if (parsed.profileVillage) inputs.profileVillage.value = parsed.profileVillage;
          if (parsed.birthday) inputs.birthday.value = parsed.birthday;
          if (parsed.gender) inputs.gender.value = parsed.gender;
          if (parsed.height) inputs.height.value = parsed.height;
          if (parsed.weight) inputs.weight.value = parsed.weight;
          if (parsed.disease) inputs.disease.value = parsed.disease;
          if (parsed.allergy) inputs.allergy.value = parsed.allergy;
          
          if (parsed.pictureUrl) {
            avatarContainer.innerHTML = `<img src="${parsed.pictureUrl}" alt="Profile" class="w-20 h-20 rounded-full object-cover border-3 border-white shadow-md ring-4 ring-emerald-100" />`;
          }
        } catch (e) {
          console.error("Failed to load profile:", e);
        }
      }

      // Check Liff for picture if missing
      try {
        await liff.init({ liffId: LIFF_ID });
        if (liff.isLoggedIn()) {
          const profile = await liff.getProfile();
          if (profile.pictureUrl && !savedData?.includes("pictureUrl")) {
            avatarContainer.innerHTML = `<img src="${profile.pictureUrl}" alt="Profile" class="w-20 h-20 rounded-full object-cover border-3 border-white shadow-md ring-4 ring-emerald-100" />`;
          }
        }
      } catch (err) {
        console.error("LIFF Init Error:", err);
      }

      checkValidity();
    }

    function checkValidity() {
      const isValid = inputs.profileName.value.trim().length > 0 && inputs.profileVillage.value.trim().length > 0;
      if (isValid) {
        saveBtn.disabled = false;
        saveBtn.classList.remove('cursor-not-allowed', 'opacity-50');
        saveBtn.classList.add('cursor-pointer', 'active:scale-[0.98]', 'hover:opacity-95');
      } else {
        saveBtn.disabled = true;
        saveBtn.classList.add('cursor-not-allowed', 'opacity-50');
        saveBtn.classList.remove('cursor-pointer', 'active:scale-[0.98]', 'hover:opacity-95');
      }
    }

    inputs.profileName.addEventListener('input', checkValidity);
    inputs.profileVillage.addEventListener('change', checkValidity);

    saveBtn.addEventListener('click', () => {
      saveBtnText.innerText = 'กำลังบันทึก...';
      saveBtn.disabled = true;

      try {
        const existing = localStorage.getItem("user_profile_data");
        const prev = existing ? JSON.parse(existing) : {};

        const userData = {
          ...prev,
          profileName: inputs.profileName.value.trim(),
          profileVillage: inputs.profileVillage.value.trim(),
          birthday: inputs.birthday.value.trim(),
          gender: inputs.gender.value.trim(),
          height: inputs.height.value.trim(),
          weight: inputs.weight.value.trim(),
          disease: inputs.disease.value.trim(),
          allergy: inputs.allergy.value.trim(),
        };

        localStorage.setItem("user_profile_data", JSON.stringify(userData));
        window.location.href = "/profile";
      } catch (error) {
        console.error("Save error:", error);
        saveBtnText.innerText = 'บันทึกข้อมูล';
        saveBtn.disabled = false;
      }
    });

    init();
  </script>
</body>
</html>
