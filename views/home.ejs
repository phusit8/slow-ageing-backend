<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>หน้าหลัก - Slow Aging</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Iconify -->
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <!-- LIFF SDK -->
  <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap');
    body {
      font-family: 'Prompt', sans-serif;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-start items-center py-5 sm:py-8 px-4 sm:px-6" style="background-color: #f5f7f5;">

  <!-- Container -->
  <div class="w-full max-w-md sm:max-w-lg md:max-w-xl mx-auto flex flex-col space-y-5 sm:space-y-6 pb-12">
    
    <!-- Top Header -->
    <header class="flex items-center justify-between pt-2 pb-1">
      <div class="flex items-center gap-2.5 sm:gap-3">
        <span class="text-3xl sm:text-4xl text-amber-500">☀️</span>
        <h1 id="greetingText" class="text-2xl sm:text-3xl font-extrabold tracking-tight" style="color: #1a2e1a;">
          สวัสดีตอนเช้า
        </h1>
      </div>

      <a href="/profile" class="flex items-center gap-2 px-4 py-2 rounded-2xl text-white text-base font-bold shadow-sm hover:opacity-95 active:scale-95 transition-transform cursor-pointer" style="background: #2d7a3a;">
        <span class="iconify text-xl" data-icon="mdi:account-circle-outline"></span>
        <span>โปรไฟล์</span>
      </a>
    </header>

    <!-- User Card -->
    <div class="flex items-center gap-4 sm:gap-5 py-2">
      <img
        id="userPicture"
        src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=200&auto=format&fit=crop&q=80"
        alt="Profile"
        class="w-22 h-22 sm:w-26 sm:h-26 rounded-full object-cover shadow-md border-3 border-white ring-4 ring-emerald-100 flex-shrink-0"
        style="width: 5.5rem; height: 5.5rem;"
      />
      <div class="flex flex-col space-y-0.5 sm:space-y-1">
        <h2 id="userName" class="text-2xl sm:text-3xl font-extrabold leading-tight" style="color: #1a2e1a;">
          คุณยายสมศรี
        </h2>
        <div class="flex items-center gap-1.5 text-base sm:text-lg font-semibold" style="color: #2d7a3a;">
          <span class="iconify text-xl shrink-0" data-icon="mdi:map-marker-outline"></span>
          <span id="userVillage">ชุมชนบ้านสุขใจ</span>
        </div>
        <div class="flex items-center gap-1.5 text-sm sm:text-base font-medium" style="color: #4a5d4e;">
          <span class="iconify text-lg shrink-0" data-icon="mdi:calendar-month-outline"></span>
          <span id="currentThaiDate">-</span>
        </div>
      </div>
    </div>

    <!-- Progress Card -->
    <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-stone-200/80">
      <h3 class="text-lg sm:text-xl font-extrabold mb-4 text-[#1a2e1a]">
        ความก้าวหน้าวันนี้
      </h3>

      <div class="flex items-center justify-between gap-4 sm:gap-6">
        
        <!-- ฝั่งซ้าย: วงกลม Progress -->
        <div class="relative w-28 h-28 sm:w-32 sm:h-32 flex items-center justify-center shrink-0">
          <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="38" fill="transparent" stroke="#e2f5e8" stroke-width="11" />
            <circle
              id="progressCircle"
              cx="50"
              cy="50"
              r="38"
              fill="transparent"
              stroke="#2d7a3a"
              stroke-width="11"
              stroke-dasharray="238.7"
              stroke-dashoffset="238.7"
              stroke-linecap="round"
              class="transition-all duration-700 ease-out"
            />
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a]">
              <span id="progressPercentText">0</span><span class="text-base sm:text-lg">%</span>
            </span>
          </div>
        </div>

        <!-- ฝั่งขวา: สถิติและปุ่ม -->
        <div class="flex-1 flex flex-col justify-center space-y-2 pl-2">
          <div>
            <span class="text-lg sm:text-xl font-bold block text-[#1a2e1a] leading-tight">
              ทำภารกิจแล้ว
            </span>
            <span class="text-base sm:text-lg font-extrabold block text-[#2d7a3a] mt-0.5">
              <span id="completedTasksText">0</span> จาก <span id="totalTasksText">4</span> ท่า
            </span>
          </div>

          <a href="/tasks" class="flex items-center justify-between px-4 sm:px-5 py-2.5 sm:py-3 rounded-2xl text-white text-base font-bold shadow-md hover:opacity-95 active:scale-95 transition-transform cursor-pointer w-full sm:w-fit gap-2" style="background: #2d7a3a;">
            <span>ดูภารกิจวันนี้</span>
            <span class="iconify text-xl" data-icon="mdi:chevron-right"></span>
          </a>
        </div>

      </div>
    </div>

    <!-- Action Menu Cards List -->
    <div class="space-y-3 pt-1">
      
      <!-- Card 1 -->
      <a href="/tasks" class="group flex items-center justify-between p-4 sm:p-5 rounded-3xl bg-white shadow-sm border border-stone-200/80 hover:border-emerald-300 transition-all cursor-pointer active:scale-[0.99] block">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 sm:w-15 sm:h-15 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-xs" style="background: #eef6ff;">
            <span class="iconify text-2xl sm:text-3xl" data-icon="mdi:dumbbell" style="color: #0066cc;"></span>
          </div>
          <div>
            <h4 class="text-lg sm:text-xl font-bold text-[#1a2e1a]">ภารกิจวันนี้</h4>
            <p class="text-xs sm:text-sm text-stone-500 font-medium mt-0.5">ออกกำลังกายและกิจกรรมเพื่อสุขภาพ</p>
          </div>
        </div>
        <span class="iconify text-2xl text-stone-400 group-hover:text-stone-800 transition-colors shrink-0 ml-2" data-icon="mdi:chevron-right"></span>
      </a>

      <!-- Card 2 -->
      <a href="/calendar" class="group flex items-center justify-between p-4 sm:p-5 rounded-3xl bg-white shadow-sm border border-stone-200/80 hover:border-emerald-300 transition-all cursor-pointer active:scale-[0.99] block">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 sm:w-15 sm:h-15 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-xs" style="background: #f2f9ed;">
            <span class="iconify text-2xl sm:text-3xl" data-icon="mdi:calendar-month-outline" style="color: #68a82d;"></span>
          </div>
          <div>
            <h4 class="text-lg sm:text-xl font-bold text-[#1a2e1a]">ปฏิทินรายเดือน</h4>
            <p class="text-xs sm:text-sm text-stone-500 font-medium mt-0.5">ดูตารางกิจกรรม</p>
          </div>
        </div>
        <span class="iconify text-2xl text-stone-400 group-hover:text-stone-800 transition-colors shrink-0 ml-2" data-icon="mdi:chevron-right"></span>
      </a>

      <!-- Card 3 -->
      <a href="/progress" class="group flex items-center justify-between p-4 sm:p-5 rounded-3xl bg-white shadow-sm border border-stone-200/80 hover:border-emerald-300 transition-all cursor-pointer active:scale-[0.99] block">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 sm:w-15 sm:h-15 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-xs" style="background: #eef6ff;">
            <span class="iconify text-2xl sm:text-3xl" data-icon="mdi:chart-box-outline" style="color: #0066cc;"></span>
          </div>
          <div>
            <h4 class="text-lg sm:text-xl font-bold text-[#1a2e1a]">ความก้าวหน้า</h4>
            <p class="text-xs sm:text-sm text-stone-500 font-medium mt-0.5">ดูสถิติและความก้าวหน้าของคุณ</p>
          </div>
        </div>
        <span class="iconify text-2xl text-stone-400 group-hover:text-stone-800 transition-colors shrink-0 ml-2" data-icon="mdi:chevron-right"></span>
      </a>

    </div>
  </div>

  <script>
    // ตัวแปร Default
    let totalTasks = 4;
    let completedTasksCount = 3;
    
    // ตั้งค่าเวลาทักทายและวันที่ภาษาไทย
    function setDateAndGreeting() {
      const now = new Date();
      const days = ["อาทิตย์", "จันทร์", "อังคาร", "พุธ", "พฤหัสบดี", "ศุกร์", "เสาร์"];
      const months = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];

      const dayName = days[now.getDay()];
      const dateNum = now.getDate();
      const monthName = months[now.getMonth()];
      const thaiYear = now.getFullYear() + 543;

      document.getElementById("currentThaiDate").innerText = `วัน${dayName} ที่ ${dateNum} ${monthName} ${thaiYear}`;

      const hours = now.getHours();
      let greeting = "สวัสดีตอนเย็น";
      if (hours < 12) {
        greeting = "สวัสดีตอนเช้า";
      } else if (hours < 16) {
        greeting = "สวัสดีตอนบ่าย";
      }
      document.getElementById("greetingText").innerText = greeting;
    }

    // ฟังก์ชันคำนวณ Progress Bar วงกลม
    function updateProgress() {
      const progressPercent = Math.round((completedTasksCount / totalTasks) * 100);
      document.getElementById("completedTasksText").innerText = completedTasksCount;
      document.getElementById("totalTasksText").innerText = totalTasks;
      document.getElementById("progressPercentText").innerText = progressPercent;

      // คำนวณ Stroke Dash Offset
      const maxOffset = 238.7;
      const offset = maxOffset * (1 - progressPercent / 100);
      const circle = document.getElementById("progressCircle");
      
      // Delay นิดนึงเพื่อให้เห็น Animation หมุนตอนเปิดหน้าเว็บ
      setTimeout(() => {
        circle.style.strokeDashoffset = offset;
      }, 100);
    }

    // 🔴 กำหนด LIFF ID 
    const LIFF_ID = "<%= LIFF_ID %>";

    async function initData() {
      // 1. จัดการวันที่และทักทาย
      setDateAndGreeting();

      // 2. ดึงข้อมูล User Profile จาก LocalStorage
      const savedData = localStorage.getItem("user_profile_data");
      let hasLocalData = false;

      if (savedData) {
        try {
          const parsed = JSON.parse(savedData);
          if (parsed.profileName) document.getElementById("userName").innerText = parsed.profileName;
          if (parsed.profileVillage) document.getElementById("userVillage").innerText = parsed.profileVillage;
          if (parsed.pictureUrl) document.getElementById("userPicture").src = parsed.pictureUrl;
          hasLocalData = true;
        } catch (e) {
          console.error("Failed to parse saved user data:", e);
        }
      }

      // 3. จัดการภารกิจ
      const savedTasks = localStorage.getItem("exercise_tasks_data");
      if (savedTasks) {
        try {
          const parsedTasks = JSON.parse(savedTasks);
          completedTasksCount = parsedTasks.filter(t => t.completed).length;
          totalTasks = parsedTasks.length;
        } catch (e) {
          console.error("Failed to parse tasks data:", e);
        }
      }

      updateProgress();

      // 4. เรียก LIFF เพื่อเอาข้อมูลล่าสุด (ถ้ามี)
      try {
        await liff.init({ liffId: LIFF_ID });
        if (liff.isLoggedIn()) {
          const profile = await liff.getProfile();
          // อัปเดตข้อมูลถ้าใน LocalStorage ไม่มี (หรือจะเอา LIFF ทับเลยก็ได้)
          if (!hasLocalData && profile.displayName) {
            document.getElementById("userName").innerText = profile.displayName;
          }
          if (!hasLocalData && profile.pictureUrl) {
            document.getElementById("userPicture").src = profile.pictureUrl;
          }
        }
      } catch (err) {
        console.error("LIFF Init Error:", err);
      }
    }

    // เรียกตอนโหลดหน้าเสร็จ
    initData();
  </script>
</body>
</html>
