<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ภารกิจวันนี้ - Slow Aging</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Iconify -->
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap');
    body {
      font-family: 'Prompt', sans-serif;
    }
    .hidden { display: none !important; }
  </style>
</head>
<body class="bg-[#f5f7f5]">

  <!-- =========================================================
       VIEW 1: หน้าจอภารกิจวันนี้ (รายการ)
       ========================================================= -->
  <div id="listView" class="flex flex-col min-h-screen w-full justify-between">
    <div class="w-full max-w-md md:max-w-2xl lg:max-w-3xl mx-auto flex-1 flex flex-col justify-between px-5 sm:px-8 pt-6 sm:pt-10 pb-10">
      <div>
        <!-- Header -->
        <div class="relative flex items-center justify-center mb-6 sm:mb-8">
          <a href="/home" class="absolute left-0 p-2 -ml-2 text-black cursor-pointer hover:bg-stone-200/60 rounded-2xl transition-colors">
            <span class="iconify text-3xl sm:text-4xl" data-icon="mdi:arrow-left"></span>
          </a>
          <div class="text-center">
            <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1a2e1a]">ภารกิจวันนี้</h1>
            <p id="currentThaiDate" class="text-lg sm:text-xl font-bold text-[#2d7a3a] mt-1.5">-</p>
          </div>
        </div>

        <!-- Task Cards Container -->
        <div id="taskListContainer" class="space-y-4 sm:space-y-5">
          <!-- Inject by JS -->
        </div>
      </div>

      <!-- Bottom Box: แสดงเฉพาะเมื่อมีกิจกรรมค้าง -->
      <div id="incompleteBox" class="pt-8 hidden">
        <a href="/tasks/incomplete" class="block w-full py-5 rounded-2xl border-2 border-red-300 bg-white text-center text-xl sm:text-2xl font-extrabold text-[#d32f2f] hover:bg-red-50 active:scale-[0.99] transition-all cursor-pointer shadow-sm">
          กิจกรรมที่ยังไม่เสร็จ
        </a>
      </div>
    </div>
  </div>

  <!-- =========================================================
       VIEW 2: หน้าจอวิธีทำท่า (รายละเอียด)
       ========================================================= -->
  <div id="detailView" class="hidden flex flex-col min-h-screen w-full bg-[#f5f7f5] justify-between">
    <div class="w-full max-w-md md:max-w-2xl lg:max-w-3xl mx-auto flex-1 flex flex-col px-5 sm:px-8 pt-6 sm:pt-10 pb-10">
      <!-- Header -->
      <div class="flex items-center mb-6 sm:mb-8">
        <button onclick="closeDetailView()" class="p-2 -ml-2 text-black cursor-pointer hover:bg-stone-200/60 rounded-2xl transition-colors">
          <span class="iconify text-3xl sm:text-4xl" data-icon="mdi:arrow-left"></span>
        </button>
        <h1 id="detailHeaderTitle" class="text-3xl sm:text-4xl font-extrabold text-center flex-1 pr-8 sm:pr-10 text-[#1a2e1a]">
          วิธีทำท่า
        </h1>
      </div>

      <!-- Guide Video / Image Banner -->
      <div class="relative w-full rounded-3xl overflow-hidden mb-6 sm:mb-8 bg-stone-100 border-2 border-stone-200 shadow-sm">
        <img id="detailImage" src="" alt="Thumbnail" class="w-full h-64 sm:h-80 md:h-96 object-cover" />
        <div class="absolute inset-0 flex items-center justify-center bg-black/25">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-white/95 flex items-center justify-center text-stone-800 shadow-xl">
            <span class="iconify text-5xl sm:text-6xl ml-1 text-[#2d7a3a]" data-icon="mdi:play"></span>
          </div>
        </div>
        <!-- Guide Step Labels -->
        <div id="guideImagesContainer" class="absolute top-3 inset-x-3 flex justify-between gap-2 text-sm sm:text-base text-stone-800 font-bold"></div>
      </div>

      <!-- Title & Info -->
      <div class="space-y-2 mb-6 sm:mb-8 bg-white p-6 rounded-3xl border border-stone-200 shadow-sm">
        <h2 id="detailTitle" class="text-3xl sm:text-4xl font-extrabold text-[#1a2e1a]"></h2>
        <p id="detailReps" class="text-2xl sm:text-3xl font-extrabold text-[#2d7a3a]"></p>
        <p id="detailDuration" class="text-lg sm:text-xl font-bold text-stone-600"></p>
      </div>

      <!-- วิธีทำ -->
      <div class="space-y-4 mb-6 sm:mb-8 bg-white p-6 rounded-3xl border border-stone-200 shadow-sm">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a]">วิธีทำ</h3>
        <div id="detailSteps" class="space-y-3 text-xl sm:text-2xl text-stone-800 leading-relaxed font-medium"></div>
      </div>

      <!-- ข้อควรระวัง -->
      <div class="p-5 bg-amber-50 rounded-2xl border-2 border-amber-200 mb-8">
        <p class="text-lg sm:text-xl font-bold text-amber-900 mb-1">⚠️ ข้อควรระวัง</p>
        <p id="detailCaution" class="text-base sm:text-lg text-amber-800 font-semibold leading-relaxed"></p>
      </div>

      <!-- ปุ่มทำเสร็จแล้ว -->
      <div class="mt-auto pt-2">
        <button id="toggleCompleteBtn" class="w-full flex items-center justify-center gap-3 py-5 sm:py-6 rounded-2xl font-extrabold text-white text-2xl sm:text-3xl cursor-pointer active:scale-[0.98] transition-transform shadow-lg" style="background: #2d7a3a;">
          <span class="iconify text-3xl sm:text-4xl" data-icon="mdi:check"></span>
          <span id="toggleCompleteBtnText">ทำเสร็จแล้ว</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    // ข้อมูลเริ่มต้น (Default Tasks)
    const defaultTasks = [
      {
        id: 1, title: "บริหารคอ", reps: "10 ครั้ง", duration: "(ประมาณ 1 นาที)", completed: false,
        image: "https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=400&auto=format&fit=crop&q=80",
        steps: ["1. นั่งหรือยืนหลังตรง ผ่อนคลายไหล่", "2. ค่อยๆ หมุนคอไปทางซ้ายช้าๆ", "3. กลับมาที่ท่าตรงกลาง", "4. หมุนคอไปทางขวาช้าๆ", "5. ทำซ้ำจนครบตามจำนวน"],
        caution: "ควรทำช้าๆ ไม่กระตุก หากรู้สึกเวียนศีรษะให้หยุดทันที",
        guideImages: ["1. ก้มคอ", "2. เอียงคอ", "3. หันคอ", "4. เงยหน้า"],
      },
      {
        id: 2, title: "ยกแขนขึ้น-ลง", reps: "15 ครั้ง", duration: "(ประมาณ 1 นาที)", completed: false,
        image: "https://images.unsplash.com/photo-1518611012118-696072aa579a?w=400&auto=format&fit=crop&q=80",
        steps: ["1. นั่งตัวตรง เท้าทั้งสองข้างวางราบกับพื้น", "2. ค่อยๆ ยกแขนทั้งสองข้างขึ้นเหนือศีรษะช้าๆ", "3. ค้างไว้ 2-3 วินาที พร้อมหายใจเข้า", "4. ผ่อนแขนลงแนบลำตัวช้าๆ พร้อมหายใจออก", "5. ทำซ้ำจนครบตามจำนวน"],
        caution: "ยกแขนเท่าที่ไม่รู้สึกเจ็บ ไม่ควรฝืนยกสูงเกินไป",
        guideImages: ["1. ท่าเตรียม", "2. ยกแขน", "3. ค้างไว้", "4. ผ่อนลง"],
      },
      {
        id: 3, title: "เดินอยู่กับที่", reps: "2 นาที", duration: "(ประมาณ 2 นาที)", completed: false,
        image: "https://images.unsplash.com/photo-1476480862126-209bfaa8edc8?w=400&auto=format&fit=crop&q=80",
        steps: ["1. ยืนตัวตรงอย่างมั่นคง (เกาะโต๊ะได้ถ้าทรงตัวไม่ดี)", "2. ก้าวเท้ายกเข่าขึ้นสลับซ้าย-ขวา ช้าๆ", "3. แกว่งแขนตามจังหวะอย่างเป็นธรรมชาติ", "4. เดินต่อเนื่องตามเวลาที่กำหนด"],
        caution: "หากทรงตัวไม่ดี ควรยืนใกล้เก้าอี้หรือโต๊ะเพื่อจับพยุงตัว",
        guideImages: ["1. ท่ายืน", "2. ยกเข่าซ้าย", "3. สลับขวา", "4. เดินต่อเนื่อง"],
      },
      {
        id: 4, title: "เหยียดขา", reps: "10 ครั้ง", duration: "(ประมาณ 1 นาที)", completed: false,
        image: "https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=400&auto=format&fit=crop&q=80",
        steps: ["1. นั่งบนเก้าอี้ที่มั่นคง หลังตรง", "2. เหยียดขาข้างหนึ่งตรงไปข้างหน้า", "3. เกร็งค้างไว้ 3-5 วินาที", "4. วางเท้าลงแล้วสลับทำอีกข้าง", "5. ทำซ้ำจนครบตามจำนวน"],
        caution: "นั่งบนเก้าอี้ที่ไม่มีล้อเลื่อน เพื่อความปลอดภัย",
        guideImages: ["1. นั่งหลังตรง", "2. เหยียดขา", "3. เกร็งค้าง", "4. สลับข้าง"],
      }
    ];

    let tasks = [];
    let currentSelectedTask = null;

    function init() {
      // ตั้งค่าวันที่ภาษาไทย
      const now = new Date();
      const days = ["อาทิตย์","จันทร์","อังคาร","พุธ","พฤหัสบดี","ศุกร์","เสาร์"];
      const months = ["มกราคม","กุมภาพันธ์","มีนาคม","เมษายน","พฤษภาคม","มิถุนายน","กรกฎาคม","สิงหาคม","กันยายน","ตุลาคม","พฤศจิกายน","ธันวาคม"];
      document.getElementById("currentThaiDate").innerText = `วัน${days[now.getDay()]}ที่ ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear() + 543}`;

      // โหลด Task จาก LocalStorage
      const savedTasks = localStorage.getItem("exercise_tasks_data");
      if (savedTasks) {
        try {
          tasks = JSON.parse(savedTasks);
        } catch (e) {
          tasks = defaultTasks;
        }
      } else {
        tasks = defaultTasks;
        localStorage.setItem("exercise_tasks_data", JSON.stringify(tasks));
      }

      // เช็คว่ามี Task ค้างในวันก่อนหรือไม่
      const previousIncomplete = localStorage.getItem("previous_incomplete_tasks");
      if (previousIncomplete && JSON.parse(previousIncomplete).length > 0) {
        document.getElementById("incompleteBox").classList.remove("hidden");
      }

      renderTaskList();
    }

    function renderTaskList() {
      const container = document.getElementById("taskListContainer");
      container.innerHTML = "";

      tasks.forEach((task, idx) => {
        const card = document.createElement("div");
        card.className = "flex items-center gap-5 p-5 sm:p-6 rounded-3xl border-2 border-stone-200 bg-white cursor-pointer active:scale-[0.99] hover:border-emerald-400 transition-all shadow-sm";
        card.onclick = () => openDetailView(task.id);

        card.innerHTML = `
          <img src="${task.image}" alt="${task.title}" class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover shrink-0 shadow-xs border border-stone-200" />
          <div class="flex-1 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a2e1a] truncate">${idx + 1}. ${task.title}</h3>
            <p class="text-lg sm:text-xl text-[#2d7a3a] font-bold mt-1">${task.reps} <span class="text-stone-500 font-semibold">${task.duration}</span></p>
            <div class="mt-2 flex items-center gap-1.5">
              ${task.completed 
                ? '<span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-base font-extrabold bg-emerald-100 text-[#2d7a3a]"><span class="iconify text-xl" data-icon="mdi:check-circle"></span> ทำเสร็จแล้ว</span>' 
                : '<span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-base font-bold bg-stone-100 text-stone-600"><span class="iconify text-xl" data-icon="mdi:clock-outline"></span> ยังไม่ได้ทำ</span>'
              }
            </div>
          </div>
          <span class="iconify text-3xl text-stone-400 shrink-0" data-icon="mdi:chevron-right"></span>
        `;
        container.appendChild(card);
      });
    }

    function openDetailView(taskId) {
      currentSelectedTask = tasks.find(t => t.id === taskId);
      if (!currentSelectedTask) return;

      document.getElementById("detailTitle").innerText = currentSelectedTask.title;
      document.getElementById("detailReps").innerText = currentSelectedTask.reps;
      document.getElementById("detailDuration").innerText = currentSelectedTask.duration;
      document.getElementById("detailImage").src = currentSelectedTask.image;
      document.getElementById("detailCaution").innerText = currentSelectedTask.caution;

      const stepsContainer = document.getElementById("detailSteps");
      stepsContainer.innerHTML = currentSelectedTask.steps.map(s => `<p class="py-1">${s}</p>`).join("");

      const guideContainer = document.getElementById("guideImagesContainer");
      if (currentSelectedTask.guideImages) {
        guideContainer.innerHTML = currentSelectedTask.guideImages.map(g => `<span class="bg-white/90 px-3 py-1.5 rounded-xl shadow-xs">${g}</span>`).join("");
      } else {
        guideContainer.innerHTML = "";
      }

      const btn = document.getElementById("toggleCompleteBtn");
      const btnText = document.getElementById("toggleCompleteBtnText");
      if (currentSelectedTask.completed) {
        btn.style.background = "#6b7280";
        btnText.innerText = "ยกเลิก (ทำใหม่อีกครั้ง)";
      } else {
        btn.style.background = "#2d7a3a";
        btnText.innerText = "ทำเสร็จแล้ว";
      }

      document.getElementById("listView").classList.add("hidden");
      document.getElementById("detailView").classList.remove("hidden");
      window.scrollTo(0, 0);
    }

    function closeDetailView() {
      document.getElementById("detailView").classList.add("hidden");
      document.getElementById("listView").classList.remove("hidden");
      window.scrollTo(0, 0);
    }

    document.getElementById("toggleCompleteBtn").addEventListener("click", () => {
      if (!currentSelectedTask) return;
      currentSelectedTask.completed = !currentSelectedTask.completed;
      localStorage.setItem("exercise_tasks_data", JSON.stringify(tasks));
      renderTaskList();
      closeDetailView();
    });

    init();
  </script>
</body>
</html>
